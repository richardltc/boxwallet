// BoxWallet GUI — the desktop front-end's window.
//
// Left nav (Home + every coin, alphabetical) switching the right-hand detail,
// which itself has a tab strip (Home / Transactions / Receive / Send / Settings,
// plus Mining / DigiDollar where the coin supports them) — mirroring the TUI.
// Live values are `in` properties pushed from gui/main.cpp over the C ABI (bw_*
// in include/boxwallet.h); this file holds no logic of its own beyond layout and
// the modal stage machines.
//
// Wired to live data: Home status, Transactions, Receive, Send, Mining, install
// and update, the sync accelerators, and both wallet flows. Still scaffolding:
// Settings and DigiDollar, which render a Placeholder.
//
// Anything that isn't presentation belongs in a shared Zig module both
// front-ends call, never here — see CLAUDE.md. Formatting in particular: amounts,
// hashrates and relative times all arrive pre-formatted, so the TUI and the GUI
// cannot round or label the same number differently.

import {
    VerticalBox, HorizontalBox, GroupBox, Button, ListView, ScrollView, LineEdit, CheckBox, SpinBox
} from "std-widgets.slint";

// One coin in the left nav (built + sorted by C++).
struct NavCoin {
    name: string,
    color: color,
    index: int, // registry index for bw_* calls (also indexes the embedded logos)
}

// One entry in the in-app file browser's directory listing.
struct BrowseEntry {
    name: string,
    is-dir: bool,
}

// One row in the Transactions list. Pre-formatted by the host — the core owns
// the numbers, C++ owns how they read.
struct WalletTxRow {
    direction: string,   // "Received" | "Sent" | "Mined"
    amount: string,      // signed, already to the coin's decimals
    when: string,        // "3 hours ago"
    confirmations: string,
    incoming: bool,      // colours the row
}

// One row in the left nav.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <brush> accent;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    background: selected ? #2b2b2b : (ta.has-hover ? #202020 : transparent);

    Rectangle {
        x: 0;
        width: 4px;
        background: root.selected ? root.accent : transparent;
    }
    HorizontalBox {
        alignment: start;
        padding-left: 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            // Unselected: the same muted grey as inactive tab headers, normal
            // size. Selected: brand colour, bold, and a bit bigger so it stands out.
            font-size: root.selected ? 16px : 14px;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? root.accent : #9a9a9a;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One tab in the detail strip: a monochrome SVG icon (tinted to the accent via
// `colorize`) beside its label, with an accent underline when selected.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <color> accent;
    callback clicked;

    property <color> fg: root.selected ? root.accent : (ta.has-hover ? #d0d0d0 : #9a9a9a);
    height: 50px;
    width: content.preferred-width + 12px;

    content := VerticalBox {
        padding: 0;
        spacing: 4px;
        alignment: center;
        // Wrap the fixed-size icon in a centering row so it sits over the middle
        // of the (wider) label rather than left-aligned in the layout cell.
        HorizontalBox {
            padding: 0;
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.fg;
                width: 22px;
                height: 22px;
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            color: root.fg;
        }
    }
    // Selected underline in the coin's accent.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? root.accent : transparent;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A circular (donut) progress gauge: an arc filled to `frac` of a full turn in
// the coin's brand colour over a grey track, a percentage in the middle, and a
// caption underneath. Drawn with a conic-gradient ring + a hole punched in the
// centre (a disc in the pane colour).
component CircleGauge inherits VerticalBox {
    in property <float> frac;
    in property <brush> fill;
    in property <string> label;
    in property <string> value; // e.g. "4,136,946" or "12.3 GB free"
    in property <string> full-text; // shown in place of "100%" when full (e.g. "Synced")

    property <float> f: Math.max(0.0, Math.min(1.0, root.frac));
    // Smoothly sweep the ring (and count the % readout) whenever the underlying
    // fraction jumps — e.g. a poll advancing the sync, or clearing to 0 on stop.
    animate f { duration: 600ms; easing: ease-in-out; }
    property <length> dia: 72px;

    padding: 0;
    spacing: 6px;
    alignment: start;
    // Wider than the ring so the longest value (e.g. "20.3 GB free") isn't
    // clipped; the label, ring and value are all centred within this width.
    min-width: 112px;

    // Caption above the ring.
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 13px;
        horizontal-alignment: center;
    }
    // Ring, centred within the gauge.
    HorizontalBox {
        padding: 0;
        alignment: center;
        Rectangle {
            width: root.dia;
            height: root.dia;
            border-radius: root.dia / 2;
            background: @conic-gradient(root.fill 0turn, root.fill root.f * 1turn, #3a3a3a root.f * 1turn, #3a3a3a 1turn);

            // Centre hole → makes the ring a donut, and holds the readout. The gap
            // (8px vs the outer circle) sets the ring thickness — ~4px.
            Rectangle {
                width: parent.width - 8px;
                height: parent.height - 8px;
                border-radius: (parent.width - 8px) / 2;
                background: #1e1e1e;
                Text {
                    text: (root.f >= 0.999 && root.full-text != "") ? root.full-text : Math.round(root.f * 100) + "%";
                    color: #e6e6e6;
                    font-size: (root.f >= 0.999 && root.full-text != "") ? 13px : 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    // Value below the ring (count / free space), monospaced.
    Text {
        text: root.value;
        color: #c8c8c8;
        font-size: 12px;
        font-family: "DejaVu Sans Mono";
        horizontal-alignment: center;
    }
}

// A status glyph in the row above the Daemon section: a monochrome SVG in the
// coin's brand colour when `active`, greyed out otherwise, with a native hover
// tooltip carrying `hint`. It can also carry a motion to draw attention —
// "hop" (a little jump), "pulse" (fade in/out) or "spin" (rotate) — that runs
// only while `moving` is true. The animated values read `animation-tick()` only
// while moving, so an idle icon costs no repaints.
component StatusIcon inherits Rectangle {
    in property <image> icon;
    in property <color> accent;
    in property <color> idle: #555555;
    in property <bool> active;
    in property <string> hint;
    in property <string> motion: "none"; // "hop" | "pulse" | "spin"
    in property <bool> moving: false;

    width: 45px;
    height: 45px;

    // Shared 0..1 ramp (2s) for hop/pulse; spin has its own, slower one below.
    property <float> t: Math.mod(animation-tick() / 1ms, 2000) / 2000;
    property <float> hp: root.t < 0.35 ? root.t / 0.35 : 1.0;
    property <length> hop: -12px * (4 * root.hp * (1.0 - root.hp));
    property <float> pulse-op: 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(root.t * 360deg));
    // Grows the icon in sync with the brightness so a pulse "breathes" outward.
    property <float> pulse-scale: 1.0 + 0.28 * (0.5 + 0.5 * Math.sin(root.t * 360deg));
    property <bool> pulsing: root.moving && root.motion == "pulse";
    // One full turn every 3.6s — quarter speed. A sync can run for hours, so the
    // spinner is there to say "still working", not to hurry anyone along.
    property <angle> spin: Math.mod(animation-tick() / 1ms, 3600) / 3600 * 360deg;

    // One-shot "breath": fire a single pulse each time `pulse-on-increase` rises
    // (e.g. the peer count ticking up). Any upward jump — 0→1 or 1→5 — is exactly
    // one pulse; equal or falling values don't pulse. Frame-clock timed like the
    // title shine, so it stops requesting repaints once the single breath ends.
    in property <int> pulse-on-increase: 0;
    property <int> poi-prev: 0;
    property <duration> shot-start: 0ms;
    property <bool> shot: false;
    function kick-pulse() {
        root.shot-start = animation-tick();
        root.shot = true;
    }
    changed pulse-on-increase => {
        if root.pulse-on-increase > root.poi-prev {
            root.kick-pulse();
        }
        root.poi-prev = root.pulse-on-increase;
    }
    // 0..1 over 600ms while shooting; a single sine bump peaks mid-way then settles.
    property <float> st: root.shot ? (animation-tick() - root.shot-start) / 600ms : 1.0;
    changed st => {
        if root.shot && root.st >= 1.0 {
            root.shot = false;
        }
    }
    property <float> shot-scale: 1.0 + 0.32 * Math.sin(Math.clamp(root.st, 0.0, 1.0) * 180deg);

    Image {
        source: root.icon;
        colorize: root.active ? root.accent : root.idle;
        width: 33px;
        height: 33px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + ((root.moving && root.motion == "hop") ? root.hop : 0px);
        opacity: root.pulsing ? root.pulse-op : 1.0;
        // Scale via a GPU transform around the icon's centre (not by resizing the
        // element), so growing the pulse doesn't pixel-snap/jitter. The same
        // centred origin makes the spin rotate in place rather than orbit.
        transform-scale: root.pulsing ? root.pulse-scale : (root.shot ? root.shot-scale : 1.0);
        transform-rotation: (root.moving && root.motion == "spin") ? root.spin : 0deg;
        transform-origin: { x: 16.5px, y: 16.5px };
    }
    Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// A title wordmark with a one-shot light-sweep shine through the letters. The
// sweep runs on first appearance (`init`) and again whenever the text changes
// (`changed caption`) — so switching straight from one coin to another, which
// only updates the caption of a title element that already exists, still shines.
//
// `animation-tick()` is read only while `sweeping`, so once the ~1.5s sweep ends
// the title stops requesting repaints (no continuous cost when idle).
component ShiningTitle inherits Text {
    in property <string> caption;
    in property <color> base: #7ca071;
    in property <color> shine: #ffffff;

    property <duration> start-tick: 0ms;
    property <bool> sweeping: false;

    function sweep() {
        root.start-tick = animation-tick();
        root.sweeping = true;
    }
    init => {
        root.sweep();
    }
    changed caption => {
        root.sweep();
    }

    // 0..1 over 1.5s while sweeping; pinned at 1 (band off-screen) when idle.
    // Progress is measured on the frame clock (`animation-tick()`), and the sweep
    // ends when progress itself reaches 1 — NOT on a wall-clock timer, which
    // could fire early under frame throttling and cut the sweep off halfway.
    // While sweeping, reading `animation-tick()` keeps frames coming, so it
    // always runs to completion; once done it stops reading it (no idle repaints).
    property <float> t: root.sweeping ? (animation-tick() - root.start-tick) / 1500ms : 1.0;
    changed t => {
        if root.sweeping && root.t >= 1.0 {
            root.sweeping = false;
        }
    }
    property <float> c: root.t * 1.6 - 0.3;

    text: root.caption;
    color: @linear-gradient(100deg,
        root.base 0%,
        root.base clamp(c - 0.18, 0.0, 1.0) * 100%,
        root.shine clamp(c, 0.0, 1.0) * 100%,
        root.base clamp(c + 0.18, 0.0, 1.0) * 100%,
        root.base 100%);
}

// A placeholder tab body — a heading plus a note about what will live here.
component Placeholder inherits VerticalBox {
    in property <string> heading;
    in property <string> note;
    alignment: start;
    spacing: 6px;
    Text {
        text: root.heading;
        color: #d0d0d0;
        font-size: 18px;
        font-weight: 600;
    }
    Text {
        text: root.note;
        color: #9a9a9a;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "BoxWallet";
    icon: @image-url("coin-logos/BoxWallet.png");
    // The size the window opens at. Driven from C++ (the geometry remembered in
    // BoxWallet's conf — see bw_window_geometry), falling back to these defaults
    // on a first run. It has to reach Slint as the *preferred* size rather than
    // through Window::set_size: showing the window always settles it on its
    // preferred size, so a set_size is undone moments later, and once the window
    // is up a compositor is free to ignore an app resizing itself (COSMIC does).
    // The preferred size is the one thing that is honoured on every platform.
    // Logical pixels, so the window is the same apparent size on a HiDPI screen.
    in-out property <length> initial-width: 700px;
    in-out property <length> initial-height: 580px;
    preferred-width: root.initial-width;
    preferred-height: root.initial-height;
    background: #1e1e1e;

    // Who we are, taken from the core (bw_app_name / bw_app_version /
    // bw_brand_color) rather than written here. The version used to be a literal
    // in this file, which is how a UI ends up announcing a release it isn't.
    // `app-version` has no "v" — the label adds one.
    in property <string> app-name: "BoxWallet";
    in property <string> app-version: "";
    in property <color> brand-color: #7ca071;

    // Navigation. -1 = Home, otherwise the selected coin's registry index.
    in property <[NavCoin]> nav-coins;
    // Per-coin logos, embedded into the binary at build time and indexed by the
    // coin's registry index (NavCoin.index) — the order MUST match the coin order
    // in src/registry.zig. Swap a file in gui/coin-logos/ and rebuild to change
    // a logo.
    //
    // Slint needs `@image-url` to be a literal, so this array can't be generated
    // from the registry. `coin-logo-names` below is the safety net: C++ checks it
    // against bw_coin_name() at startup, so a coin inserted in the registry and
    // appended here is caught rather than quietly putting Bitcoin's brand over
    // Litecoin's balance. Keep the two lists in lockstep.
    property <[image]> coin-logos: [
        @image-url("coin-logos/nexa.png"), // 0
        @image-url("coin-logos/divi.png"), // 1
        @image-url("coin-logos/ergo.png"), // 2
        @image-url("coin-logos/digibyte.png"), // 3
        @image-url("coin-logos/zano.png"), // 4
        @image-url("coin-logos/nerva.png"), // 5
        @image-url("coin-logos/reddcoin.png"), // 6
        @image-url("coin-logos/epic.png"), // 7
        @image-url("coin-logos/salvium.png"), // 8
        @image-url("coin-logos/litecoin.png"), // 9
        @image-url("coin-logos/bitcoin.png"), // 10
        @image-url("coin-logos/bitcoinz.png"), // 11
        @image-url("coin-logos/spiderbyte.png"), // 12
        @image-url("coin-logos/monero.png"), // 13
    ];
    // The coin each `coin-logos` slot is meant for, as bw_coin_name() spells it.
    // Verified at startup; see the note above.
    out property <[string]> coin-logo-names: [
        "Nexa", // 0
        "Divi", // 1
        "Ergo", // 2
        "DigiByte", // 3
        "Zano", // 4
        "Nerva", // 5
        "ReddCoin", // 6
        "Epic Cash", // 7
        "Salvium", // 8
        "Litecoin", // 9
        "Bitcoin", // 10
        "BitcoinZ", // 11
        "SpiderByte", // 12
        "Monero", // 13
    ];
    // Set when that check fails: the logos are then suppressed entirely and this
    // reads as a banner, because a wrong logo on a wallet is worse than none.
    in property <string> logo-mismatch: "";
    property <int> selected: -1;
    property <int> tab: 0; // 0 Home, 1 Tx, 2 Receive, 3 Send, 4 Settings, 5 Mining, 6 DigiDollar
    callback coin-selected(int);

    // Daemon/wallet action buttons.
    in-out property <bool> daemon-busy: false; // a start/stop is in flight
    property <bool> unlock-open: false;        // passphrase modal visible
    callback start-daemon();
    callback stop-daemon();
    // Sync accelerator (Divi's blockchain snapshot): the user's answer to the
    // prompt raised before the first daemon start. Accept downloads + applies it
    // and then starts; decline starts the daemon without it.
    callback accel-accept();
    callback accel-decline();
    // Ask a running accelerator transfer to stop. What's on disk is kept, so this
    // is a pause, not a cancel — resuming picks up from the same byte.
    callback accel-pause();
    // Pick a paused transfer back up, from the same byte. The counterpart to
    // `accel-pause`: the one button toggles between them.
    callback accel-continue();
    callback install-coin();
    callback update-coin();
    callback lock-wallet();
    callback unlock-wallet(string); // passphrase (secret; cleared right after)

    // Selected-coin metadata (pushed by C++ when the selection changes).
    in property <color> coin-color: #ed295a;
    in property <string> coin-name: "";
    in property <string> coin-desc: "";
    in property <bool> has-mining: false;
    in property <bool> has-stablecoin: false;

    // Live status for the selected coin's Home tab.
    in property <bool> installed: false;
    // Install progress, polled from bw_install_progress: 0 idle, 1 downloading,
    // 2 extracting. `install-frac` is < 0 when the byte total is unknown (no
    // content-length), which the bar renders as indeterminate rather than 0%.
    in property <int> install-phase: 0;
    in property <float> install-frac: 0;
    in property <string> install-bytes: ""; // e.g. "162 MB / 260 MB"
    // True from clicking Install until the worker reports back, so the button
    // can't be double-fired in the window before the first progress poll lands.
    in-out property <bool> install-busy: false;
    property <bool> installing: root.install-busy || root.install-phase != 0;
    // Update state, from bw_update_available / bw_installed_version. An installed
    // coin with no version marker reports not-available and an empty version, so
    // the GUI stays quiet rather than nagging about a version it can't read.
    in property <bool> update-available: false;
    in property <string> installed-version: "";
    property <bool> update-open: false; // update confirm modal visible
    // Sync-accelerator prompt, raised by the C++ side when the coin offers one
    // before its first daemon start (see bw_sync_accel_offered). `accel-resume`
    // is pre-formatted and empty when there's nothing to resume.
    in-out property <bool> accel-open: false;
    // True while the progress bar belongs to a sync-accelerator run rather than an
    // ordinary install — an install has nothing to pause, so the Pause button is
    // gated on this.
    in-out property <bool> accel-busy: false;
    // True once a transfer has been paused and not yet resumed. The progress
    // block stays on screen in that state — frozen bar, byte count, and the
    // Pause button flipped to Resume — so picking it back up is one click on the
    // same button that stopped it, rather than a rediscovered flow. The ordinary
    // action buttons stay live alongside it (see `installing`), so abandoning the
    // transfer and just starting the daemon is still one click too.
    in-out property <bool> accel-paused: false;
    // True between clicking Pause and the transfer actually stopping — it unwinds
    // at a chunk boundary, which on a slow link is a visible moment. Without this
    // the button sits there reading "Pause" as if the click missed.
    in-out property <bool> accel-pausing: false;
    in property <string> accel-name: "";
    in property <string> accel-detail: "";
    in property <string> accel-resume: "";
    // What the speed costs (bw_sync_accel_trust_note) — empty for an accelerator
    // that carries no such tradeoff, which is what gates the caution block.
    in property <string> accel-trust: "";
    in property <bool> running: false;
    in property <bool> synced: false;
    in property <bool> staking: false;
    // True from clicking Start until the daemon answers (the smiley pulses). The
    // remaining placeholders below stay idle until their flows are wired.
    in-out property <bool> daemon-loading: false;
    // What the daemon is doing while it's still coming up, straight from its own
    // warm-up report (bw_daemon_stage): "Loading block index…", "Rewinding…",
    // "Verifying…", "Loading blocks… 42.00%". Empty when it isn't warming up.
    in-out property <string> daemon-stage: "";
    // Wallet lock state (from bw_wallet_security): 0 unknown, 1 unencrypted,
    // 2 locked, 3 unlocked, 4 unlocked-for-staking. 0 (unknown) greys the glyph.
    in property <int> wallet-sec: 0;
    // External wallet. `ew-flags` is bw_coin_ext_wallet's bitfield (0 = this coin
    // has no managed wallet); `wallet-state` is bw_ext_wallet_state — 0 none,
    // 1 locked, 2 open, 3 rescanning. The core computes that state so the two
    // front-ends can't disagree about what "locked" means.
    in property <int> ew-flags: 0;
    in property <int> wallet-state: 0;
    // BW_EW_LAUNCH_WITH_PW, decoded in C++ because Slint has no bitwise
    // operators and this one gates a whole flow rather than a single button.
    // These wallets (Zano, Epic) spawn their process per-open with the password
    // on its command line; the core hasn't wired that lifecycle for this
    // front-end, so every op returns Unsupported and the menu says so instead.
    in property <bool> wallet-launch-with-pw: false;
    // What this coin has to show at all (the bw_coin_supports_* reads) — about the
    // *coin*, not about the wallet's current state, so they gate which tabs exist
    // rather than what's in them. Epic answers false to receive/send: a
    // MimbleWimble payment is an interactive slate exchange, with no address to
    // show and nothing to fire and forget.
    in property <bool> has-balance: false;
    in property <bool> has-transactions: false;
    in property <bool> has-receive: false;
    in property <bool> has-send: false;
    // Whether a send could actually go through *right now*. Reading a wallet and
    // spending from one are different permissions: a bitcoin-family daemon serves
    // balances and history on a locked wallet, but refuses to sign until it's
    // unlocked. So the Send tab exists on `has-send` and its button lives on this.
    in property <bool> can-send: false;
    // Canonical restore-seed length for this wallet (bw_coin_seed_word_counts'
    // first entry), for the seed-entry prompt and its live word counter.
    in property <int> seed-word-count: 25;
    // Live wallet readouts, all pre-formatted by the host. "—" while unknown.
    in property <string> balance-total: "—";
    in property <string> balance-avail: "—";
    in property <float> rescan-frac: 0;
    in property <string> receive-address: "";
    in property <[WalletTxRow]> tx-rows;
    callback new-address();
    callback send-funds(string, string);
    in-out property <bool> send-busy: false;
    in-out property <string> send-result: "";
    in-out property <bool> send-result-error: false;
    in-out property <bool> send-confirm-open: false;
    in-out property <string> send-confirm-address: "";
    in-out property <string> send-confirm-amount: "";

    // ---- wallet setup modal ----
    // One overlay, one stage machine — the GUI's mirror of the TUI's wallet
    // Modal.Stage, so the two front-ends ask the same questions in the same order.
    //   0 closed   1 menu     2 password  3 password-confirm  4 seed-input
    //   5 file     6 working  7 seed-show 8 seed-verify       9 replace-confirm
    //  10 result
    in-out property <int> wallet-stage: 0;
    // 0 create, 1 restore-seed, 2 restore-file, 3 open, 4 lock.
    in-out property <int> wallet-op: 0;
    // The created wallet's mnemonic. THE ONLY property it ever lives in, and only
    // while stages 7–8 are up — every exit path below clears it. See the secrets
    // contract in include/boxwallet.h for what that does and doesn't guarantee.
    in-out property <string> wallet-seed-words: "";
    in-out property <bool> wallet-pw-mismatch: false;
    in-out property <bool> wallet-verify-bad: false;
    in-out property <int> wallet-verify-step: 0;
    in property <int> verify-pos-1: 1;
    in property <int> verify-pos-2: 2;
    in property <int> verify-pos-3: 3;
    in-out property <string> wallet-result: "";
    in-out property <bool> wallet-result-error: false;
    in-out property <bool> wallet-replace-bad: false;

    // op, password, seed words, wallet-file path — all four secrets-bearing
    // arguments are cleared by the caller the instant this fires.
    callback wallet-setup(int, string, string, string);
    callback wallet-lock();
    callback wallet-replace();
    // Answer for the backup quiz: is `answer` the word at seed position `pos`?
    callback verify-word(int, string) -> bool;
    callback seed-discard();

    // Mining (bw_mining_status). Only fed for a has-mining coin whose daemon is
    // answering; all three clear when it stops, since the miner dies with it.
    // `mining-hashrate` arrives pre-formatted by the core (bw_format_hashrate),
    // so the two front-ends can't round or label it differently.
    in property <bool> mining: false;
    in property <int> mining-threads: 0;
    in property <string> mining-hashrate: "";
    in property <int> cpu-threads: 1;
    in-out property <bool> mining-busy: false;
    in-out property <string> mining-error: "";
    in-out property <bool> mining-stop-open: false;
    callback mining-start(int);
    callback mining-stop();
    in property <int> blocks: 0;
    in property <int> headers: 0;
    in property <int> peers: 0;
    in property <string> chain: "";
    in property <float> sync-percent: 0;
    in property <float> headers-frac: 0;
    in property <float> blocks-frac: 0;
    in property <float> disk-frac: 0;
    in property <string> headers-str: ""; // formatted header count
    in property <string> blocks-str: "";  // formatted block count
    in property <string> disk-free: "";    // free space, e.g. "12.3 GB free"
    in property <string> coin-version: ""; // bundled core version
    in property <string> coin-abbrev: ""; // ticker, e.g. "DIVI" — labels the balance
    in property <string> status-text: "";  // latest status line
    in property <bool> status-is-error: false;

    // In-app file browser. Opened from the wallet modal's "pick a wallet file"
    // stage; its overlay is declared last so it paints above that dialog.
    in-out property <bool> browse-open: false;
    in property <string> browse-path: "";
    in property <[BrowseEntry]> browse-entries;
    in property <string> picked-file: "";
    callback browse-home();
    callback browse-up();
    callback browse-enter(int);

    // ---- keyboard ----------------------------------------------------------
    // Whether anything is covering the pane. Keys must not reach the nav or the
    // tab strip while a modal is up: switching coins behind a password box would
    // leave the box asking its question about a different wallet.
    out property <bool> modal-open:
        root.browse-open || root.send-confirm-open || root.mining-stop-open
        || root.wallet-stage != 0 || root.unlock-open || root.update-open
        || root.accel-open;

    // Escape closes the topmost modal, in the same order they paint. Each arm
    // runs that modal's own Cancel path — clearing secrets included — because a
    // seed or password dropped by the button but not by Escape is exactly the
    // leak the modal exists to prevent.
    //
    // Wallet stages 6-8 are deliberately absent: 6 is already in flight and
    // abandoning it wouldn't stop it, and 7-8 are the user's one chance to write
    // the seed down. Their footers offer no Cancel either, so Escape offering one
    // would be a way out the design says shouldn't exist.
    function dismiss-modal() -> bool {
        if (root.browse-open) {
            root.browse-open = false;
            return true;
        }
        if (root.send-confirm-open) {
            root.send-confirm-open = false;
            return true;
        }
        if (root.mining-stop-open) {
            root.mining-stop-open = false;
            return true;
        }
        if (root.accel-open) {
            root.accel-open = false;
            return true;
        }
        if (root.update-open) {
            root.update-open = false;
            return true;
        }
        if (root.unlock-open) {
            root.unlock-open = false;
            return true;
        }
        if (root.wallet-stage != 0 && (root.wallet-stage < 6 || root.wallet-stage >= 9)) {
            root.seed-discard();
            root.wallet-seed-words = "";
            root.wallet-verify-step = 0;
            root.wallet-verify-bad = false;
            root.wallet-replace-bad = false;
            root.wallet-stage = 0;
            return true;
        }
        return false;
    }

    // Which tab index a number key selects, or -1 where the coin doesn't have
    // that tab. Mirrors the TUI, where 1-N index the *visible* strip.
    pure function tab-for-key(k: string) -> int {
        if (k == "1") { return 0; }
        if (k == "2") { return root.has-transactions ? 1 : -1; }
        if (k == "3") { return root.has-receive ? 2 : -1; }
        if (k == "4") { return root.has-send ? 3 : -1; }
        if (k == "5") { return 4; }
        if (k == "6") { return root.has-mining ? 5 : -1; }
        if (k == "7") { return root.has-stablecoin ? 6 : -1; }
        return -1;
    }

    forward-focus: keys;

    // Where `delta` rows from `current` lands: a registry index, -1 for Home, or
    // `no-move` when already at an end (it clamps rather than wrapping, matching
    // the TUI — holding a key doesn't loop you back to where you started).
    //
    // Resolved in C++ because `nav-coins` is alphabetical display order while
    // `selected` is a registry index, so the current row has to be searched for,
    // and a Slint function body has no loop. C++ built that list, so it is the
    // side that already knows the mapping. The state stays here: C++ answers a
    // question, it doesn't reach in and set the selection.
    callback nav-step(/* current */ int, /* delta */ int) -> int;
    property <int> no-move: -2;

    // Select `idx` exactly as clicking its nav row would, so the poller is told
    // either way. `no-move` means the key was a no-op.
    function go-to(idx: int) {
        if (idx == root.no-move) {
            return;
        }
        root.selected = idx;
        root.tab = 0;
        root.coin-selected(idx);
    }

    // Cycle to the next/previous *visible* tab, skipping the ones this coin
    // doesn't have, and stopping at the ends rather than wrapping. Unrolled for
    // the same reason: no loops in a function body, and there are only ever
    // seven tabs.
    function step-tab(delta: int) {
        if (root.try-tab(root.tab + delta)) { return; }
        if (root.try-tab(root.tab + delta * 2)) { return; }
        if (root.try-tab(root.tab + delta * 3)) { return; }
        if (root.try-tab(root.tab + delta * 4)) { return; }
        if (root.try-tab(root.tab + delta * 5)) { return; }
        root.try-tab(root.tab + delta * 6);
    }

    function try-tab(t: int) -> bool {
        if (t < 0 || t > 6 || !root.tab-visible(t)) {
            return false;
        }
        root.tab = t;
        return true;
    }

    pure function tab-visible(t: int) -> bool {
        if (t == 1) { return root.has-transactions; }
        if (t == 2) { return root.has-receive; }
        if (t == 3) { return root.has-send; }
        if (t == 5) { return root.has-mining; }
        if (t == 6) { return root.has-stablecoin; }
        return t == 0 || t == 4;
    }

    // Everything lives inside this FocusScope so unhandled keys bubble up to it
    // from whatever has focus. As a *sibling* of the content it would only ever
    // see keys while it personally held focus — which the first click on any
    // button would take away for good.
    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                return root.dismiss-modal() ? accept : reject;
            }
            // Everything below steers the pane behind the modal, so it stays out
            // while one is up. Typing is never swallowed here either way — a
            // LineEdit inside a modal holds focus and sees the key first.
            if (root.modal-open) {
                return reject;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.go-to(root.nav-step(root.selected, event.text == Key.DownArrow ? 1 : -1));
                return accept;
            }
            if (root.selected == -1) {
                return reject; // Home has no tabs
            }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.step-tab(event.text == Key.RightArrow ? 1 : -1);
                return accept;
            }
            if (root.tab-for-key(event.text) >= 0) {
                root.tab = root.tab-for-key(event.text);
                return accept;
            }
            return reject;
        }

        HorizontalBox {
            padding: 0;
            spacing: 0;

            // ---- left nav (Home pinned, coins scroll) ----
            Rectangle {
                width: 160px;
                background: #161616;
                VerticalBox {
                    padding: 8px;
                    padding-top: 12px;
                    spacing: 2px;
                    // No `alignment: start` here: the ScrollView must stretch to fill
                    // the column (Home stays fixed-height at the top). With an
                    // alignment set, the ScrollView would collapse to its preferred
                    // height and leave the lower part of the nav empty.
                    NavItem {
                        label: "Home";
                        accent: root.brand-color;
                        selected: root.selected == -1;
                        clicked => {
                            root.selected = -1;
                            root.tab = 0;
                            // -1 too: the poller has to be told we left the coin, or
                            // it keeps polling its RPC every two seconds for a pane
                            // nobody is looking at.
                            root.coin-selected(-1);
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            padding: 0;
                            spacing: 2px;
                            alignment: start;
                            for c in root.nav-coins: NavItem {
                                label: c.name;
                                accent: c.color;
                                selected: root.selected == c.index;
                                clicked => {
                                    root.selected = c.index;
                                    root.tab = 0;
                                    root.coin-selected(c.index);
                                }
                            }
                        }
                    }
                }
            }

            // ---- detail ----
            Rectangle {
                background: #1e1e1e;

                // HOME
                if root.selected == -1: VerticalBox {
                    padding: 26px;
                    spacing: 10px;
                    alignment: start;
                    // App logo + title/version.
                    HorizontalBox {
                        padding: 0;
                        spacing: 12px;
                        alignment: start;
                        Image {
                            source: @image-url("coin-logos/BoxWallet.png");
                            image-fit: contain;
                            width: 69px;
                            height: 69px;
                            vertical-alignment: center;
                        }
                        VerticalBox {
                            padding: 0;
                            spacing: 2px;
                            HorizontalBox {
                                padding: 0;
                                alignment: start;
                                ShiningTitle {
                                    caption: root.app-name;
                                    base: root.brand-color;
                                    font-size: 32px;
                                    font-weight: 800;
                                }
                            }
                            Text {
                                text: "v" + root.app-version;
                                color: #808080;
                                font-size: 14px;
                            }
                        }
                    }
                    Rectangle {
                        height: 8px;
                    }
                    Text {
                        text: "Multi-coin cryptocurrency wallet manager.";
                        color: #cfcfcf;
                        font-size: 15px;
                    }
                    Text {
                        text: "Select a coin on the left to see its status.";
                        color: #9a9a9a;
                        font-size: 14px;
                    }
                    // A build-time mistake, surfaced rather than swallowed: the coin
                    // logos no longer line up with the registry, so they've all been
                    // turned off. Only ever visible to someone running a broken build.
                    if root.logo-mismatch != "": Rectangle {
                        background: #3a2a1a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #b8863b;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: "Coin logos disabled";
                                color: #e8b45c;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: "gui/app.slint is out of step with src/registry.zig — "
                                    + root.logo-mismatch + ".";
                                color: #cfcfcf;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // COIN DETAIL (tabbed)
                if root.selected != -1: VerticalBox {
                    padding: 26px;
                    spacing: 14px;
                    // No `alignment: start` here: a tab whose body should fill the
                    // pane (Transactions' list) needs the layout to hand out the
                    // leftover height, and an alignment stops it doing that — every
                    // child collapses to its preferred size instead. The trailing
                    // spacer at the end keeps the *other* tabs packed to the top.

                    // Logo + title/description. The logo is the embedded per-coin
                    // image, selected by the coin's registry index (root.selected).
                    HorizontalBox {
                        padding: 0;
                        // No `alignment: start`: the text column has to be handed the
                        // leftover width, or the balance can't sit against the right
                        // edge. With an alignment set, children collapse to their
                        // preferred size and `horizontal-stretch` is ignored.
                        spacing: 12px;
                        // Suppressed entirely when the startup check found the logo
                        // array out of step with the registry: a coin wearing another
                        // coin's brand is worse than a coin wearing none.
                        if root.logo-mismatch == "": Image {
                            source: root.coin-logos[root.selected];
                            image-fit: contain;
                            width: 69px;
                            height: 69px;
                            vertical-alignment: center;
                        }
                        VerticalBox {
                            padding: 0;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            // Title, version and balance on one line, manually placed
                            // so each sits on the title's baseline. (A HorizontalBox
                            // centres them vertically instead, floating the small text
                            // too high.) The balance rides here rather than in its own
                            // corner so it's on every tab — the one figure a wallet
                            // exists to show shouldn't be reachable only by opening
                            // Send, which Epic doesn't even have.
                            title-row := Rectangle {
                                height: title-el.preferred-height;
                                // Whether there's a figure to show at all. Both halves
                                // of the balance go empty together.
                                property <bool> show-balance:
                                    root.has-balance && root.balance-total != "—";
                                // Gap between the branded ticker and the figure.
                                property <length> bal-gap: 7px;
                                // Left edge of the ticker + figure group, pinned so the
                                // group ends at the right edge of the line. Clamped, so
                                // a long balance on a narrow window clips off the right
                                // rather than sliding back over the version —
                                // overlapping text reads as a bug, truncated text reads
                                // as a small window.
                                property <length> bal-x: max(
                                    ver-el.x + ver-el.preferred-width + 18px,
                                    title-row.width - tick-el.preferred-width
                                        - title-row.bal-gap - bal-el.preferred-width);

                                title-el := ShiningTitle {
                                    x: 0;
                                    caption: root.coin-name;
                                    base: root.coin-color;
                                    font-size: 28px;
                                    font-weight: 800;
                                }
                                ver-el := Text {
                                    text: root.coin-version;
                                    color: #808080;
                                    font-size: 13px;
                                    x: title-el.preferred-width + 8px;
                                    // Bottom-align to the title, nudged up so the
                                    // baselines (not the box bottoms) line up.
                                    y: parent.height - self.preferred-height - 4px;
                                }
                                // The ticker wears the coin's brand colour, like the
                                // title does; the figure stays neutral so the number
                                // is what your eye lands on. Two elements because a
                                // Slint Text is one colour throughout.
                                tick-el := Text {
                                    text: title-row.show-balance ? root.coin-abbrev + ":" : "";
                                    color: root.coin-color;
                                    font-family: "DejaVu Sans Mono";
                                    font-size: 14px;
                                    font-weight: 700;
                                    x: title-row.bal-x;
                                    y: parent.height - self.preferred-height - 4px;
                                }
                                // Monospaced by the embedded font's real family name
                                // rather than the "monospace" alias — the font ships in
                                // the binary precisely so this doesn't depend on one
                                // being installed. Mono also holds the digits in their
                                // columns as the balance updates, instead of jittering.
                                bal-el := Text {
                                    text: title-row.show-balance ? root.balance-total : "";
                                    color: #e6e6e6;
                                    font-family: "DejaVu Sans Mono";
                                    font-size: 14px;
                                    x: title-row.bal-x + tick-el.preferred-width
                                        + title-row.bal-gap;
                                    y: parent.height - self.preferred-height - 4px;
                                }
                            }
                            Text {
                                text: root.coin-desc;
                                color: #9a9a9a;
                                font-size: 13px;
                            }
                        }
                    }

                    // Status glyph row — under the description, so it's visible on
                    // every tab (not just the Home/status tab).
                    HorizontalBox {
                        padding: 0;
                        spacing: 6px;
                        alignment: start;

                        // Installed — hops while not installed (pointing at the Install
                        // button), and pulses while the install itself runs.
                        StatusIcon {
                            icon: @image-url("icons/download.svg");
                            accent: root.coin-color;
                            active: root.installed || root.installing;
                            hint: root.installing
                                ? (root.install-phase == 2 ? "Installing…" : "Downloading…")
                                : (root.installed
                                    ? (root.update-available
                                        ? "Update available: " + root.installed-version + " → " + root.coin-version
                                        : "Installed")
                                    : "Not installed — use the Install button");
                            motion: root.installing ? "pulse" : "hop";
                            moving: !root.installed || root.installing;
                        }
                        // Daemon — grey when stopped, pulses while loading, lit when running.
                        StatusIcon {
                            icon: @image-url("icons/smile.svg");
                            accent: root.coin-color;
                            active: root.running || root.daemon-loading;
                            // While it's coming up, name the stage it's actually at
                            // rather than a bare "loading" — a block-index load or a
                            // rewind can run for minutes, and the difference is the
                            // only sign of progress there is.
                            hint: root.daemon-loading
                                ? (root.daemon-stage != "" ? root.daemon-stage : "Daemon loading…")
                                : (root.running ? "Daemon running" : "Daemon not running");
                            motion: "pulse";
                            moving: root.daemon-loading;
                        }
                        // Peers — lit when connected; hint shows the count.
                        StatusIcon {
                            icon: @image-url("icons/wifi.svg");
                            accent: root.coin-color;
                            active: root.running && root.peers > 0;
                            hint: "Peers: " + root.peers;
                            // Pulse once whenever a new peer connection is picked up.
                            pulse-on-increase: root.peers;
                        }
                        // Sync — spins while syncing, static when synced.
                        StatusIcon {
                            icon: @image-url("icons/refresh-cw.svg");
                            accent: root.coin-color;
                            active: root.running;
                            hint: root.running ? (root.synced ? "Synced" : "Syncing…") : "Not running";
                            motion: "spin";
                            moving: root.running && !root.synced;
                        }
                        // Wallet lock — open/closed padlock, lit once we know the
                        // wallet's state. A coin with a *managed* wallet (Nerva) has
                        // no in-daemon lock state to report, so it reads `wallet-state`
                        // instead; without this its padlock would sit permanently grey.
                        if root.ew-flags == 0: StatusIcon {
                            icon: (root.wallet-sec == 1 || root.wallet-sec == 3 || root.wallet-sec == 4)
                                ? @image-url("icons/lock-open.svg")
                                : @image-url("icons/lock.svg");
                            accent: root.coin-color;
                            active: root.wallet-sec != 0;
                            hint: root.wallet-sec == 1 ? "Wallet not encrypted"
                                : root.wallet-sec == 2 ? "Wallet locked"
                                : root.wallet-sec == 3 ? "Wallet unlocked"
                                : root.wallet-sec == 4 ? "Unlocked for staking"
                                : "Wallet status unknown";
                        }
                        if root.ew-flags != 0: StatusIcon {
                            icon: root.running && root.wallet-state >= 2
                                ? @image-url("icons/lock-open.svg")
                                : @image-url("icons/lock.svg");
                            accent: root.coin-color;
                            // Gated on `running`, like every other glyph in this
                            // row. bw_ext_wallet_state answers from *disk* — a
                            // wallet file that exists but isn't open reads as
                            // "locked" whether or not the daemon is up — so
                            // without this the padlock stayed lit on a stopped
                            // coin, reporting a live state nothing was serving.
                            // The TUI says a plain dim "Unknown" here; this is
                            // the same answer.
                            active: root.running && root.wallet-state != 0;
                            hint: !root.running ? "Wallet status unknown — the daemon isn't running"
                                : root.wallet-state == 0 ? "No wallet yet"
                                : root.wallet-state == 1 ? "Wallet locked"
                                : root.wallet-state == 3 ? "Wallet rescanning"
                                : "Wallet unlocked";
                        }
                        // Staking (PoS) or Mining (mining coins) — pulses while active.
                        if !root.has-mining: StatusIcon {
                            icon: @image-url("icons/zap.svg");
                            accent: root.coin-color;
                            active: root.staking;
                            hint: root.staking ? "Staking" : "Not staking";
                            motion: "pulse";
                            moving: root.staking;
                        }
                        if root.has-mining: StatusIcon {
                            icon: @image-url("icons/cpu.svg");
                            accent: root.coin-color;
                            active: root.mining;
                            hint: root.mining ? "Mining" : "Not mining";
                            motion: "pulse";
                            moving: root.mining;
                        }
                    }

                    // Branded divider — full coin colour in the centre, fading to the
                    // pane on both ends — between the status icons and the tab strip.
                    Rectangle {
                        height: 1px;
                        background: @linear-gradient(90deg, transparent 0%, root.coin-color 25%, transparent 100%);
                    }

                    // Tab strip.
                    HorizontalBox {
                        padding: 0;
                        spacing: 18px;
                        alignment: start;
                        TabButton {
                            label: "Home";
                            icon: @image-url("icons/home.svg");
                            accent: root.coin-color;
                            selected: root.tab == 0;
                            clicked => {
                                root.tab = 0;
                            }
                        }
                        if root.has-transactions: TabButton {
                            label: "Transactions";
                            icon: @image-url("icons/transactions.svg");
                            accent: root.coin-color;
                            selected: root.tab == 1;
                            clicked => {
                                root.tab = 1;
                            }
                        }
                        if root.has-receive: TabButton {
                            label: "Receive";
                            icon: @image-url("icons/receive.svg");
                            accent: root.coin-color;
                            selected: root.tab == 2;
                            clicked => {
                                root.tab = 2;
                            }
                        }
                        if root.has-send: TabButton {
                            label: "Send";
                            icon: @image-url("icons/send.svg");
                            accent: root.coin-color;
                            selected: root.tab == 3;
                            clicked => {
                                root.tab = 3;
                            }
                        }
                        TabButton {
                            label: "Settings";
                            icon: @image-url("icons/settings.svg");
                            accent: root.coin-color;
                            selected: root.tab == 4;
                            clicked => {
                                root.tab = 4;
                            }
                        }
                        if root.has-mining: TabButton {
                            label: "Mining";
                            icon: @image-url("icons/mining.svg");
                            accent: root.coin-color;
                            selected: root.tab == 5;
                            clicked => {
                                root.tab = 5;
                            }
                        }
                        if root.has-stablecoin: TabButton {
                            label: "DigiDollar";
                            icon: @image-url("icons/digidollar.svg");
                            accent: root.coin-color;
                            selected: root.tab == 6;
                            clicked => {
                                root.tab = 6;
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    // ---- tab bodies ----

                    // Home / status (live).
                    if root.tab == 0: VerticalBox {
                        padding: 0;
                        spacing: 14px;
                        vertical-stretch: 0;
                        alignment: start;

                        HorizontalBox {
                            padding: 4px;
                            spacing: 40px;
                            alignment: start;
                            CircleGauge {
                                label: "Headers";
                                frac: root.headers-frac;
                                fill: root.coin-color;
                                value: root.headers-str;
                                full-text: "Synced";
                            }
                            CircleGauge {
                                label: "Blocks";
                                frac: root.blocks-frac;
                                fill: root.coin-color;
                                value: root.blocks-str;
                                full-text: "Synced";
                            }
                            CircleGauge {
                                label: "Disk used";
                                frac: root.disk-frac;
                                fill: root.coin-color;
                                value: root.disk-free;
                            }
                        }
                        // Status line — the latest info/action message (like the TUI).
                        HorizontalBox {
                            padding: 0;
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "Status:";
                                color: #9a9a9a;
                                font-size: 13px;
                            }
                            Text {
                                // A daemon that's still coming up outranks the last
                                // action message: the stage moves on its own (and can
                                // do so for minutes), so it's the live answer to "what
                                // is it doing?". Otherwise the latest action/info
                                // message, falling back to "Staking" while it stakes.
                                text: root.daemon-stage != ""
                                    ? root.daemon-stage
                                    : (root.status-text != "" ? root.status-text : (root.staking ? "Staking" : ""));
                                // A live stage is progress, never an error — don't
                                // inherit the red from an earlier failed action.
                                color: root.status-is-error && root.daemon-stage == "" ? #e74c3c : #c8c8c8;
                                font-size: 13px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        // Install progress — shown in place of the button row while a
                        // download/extract runs, so the rest of the app (and the coin
                        // list) stays usable during a multi-minute install.
                        if root.installing || (root.accel-paused && !root.running): VerticalBox {
                            padding: 0;
                            spacing: 4px;
                            HorizontalBox {
                                padding: 0;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    // "Installing" rather than "Extracting": the unpack is
                                    // an implementation detail, and what the user cares
                                    // about is that the install is still working.
                                    text: root.accel-paused
                                        ? "Paused"
                                        : (root.install-phase == 2 ? "Installing…" : "Downloading…");
                                    color: #c8c8c8;
                                    font-size: 13px;
                                }
                                Text {
                                    // Downloading shows real transferred bytes. Extracting
                                    // deliberately shows only a percentage: its byte counts
                                    // are positions in the *compressed* archive, so printing
                                    // them next to "Extracting…" would read as output size
                                    // and understate what lands on disk. The percentage is
                                    // the honest part of that measure.
                                    text: root.install-phase == 2
                                        ? (root.install-frac < 0 ? "" : "\{Math.round(root.install-frac * 100)}%")
                                        : root.install-bytes;
                                    color: #9a9a9a;
                                    font-size: 13px;
                                }
                            }
                            // The bar. A known fraction fills proportionally — including
                            // while extracting, which reports its position in the archive.
                            // Where there's genuinely no fraction (a download with no
                            // content-length, or the Windows zip path, which seeks and so
                            // can't report a monotonic position) a segment sweeps the track
                            // instead, so it reads as motion rather than a stalled bar.
                            // `track` is named rather than reached through `parent`: inside a
                            // conditional element `parent` resolves to the enclosing layout,
                            // not to this Rectangle, so the fills must size against `track`.
                            track := Rectangle {
                                // A paused transfer is never indeterminate: a sweeping
                                // segment reads as work in progress, which is the one
                                // thing it isn't. With no fraction it just sits empty.
                                property <bool> indeterminate: root.install-frac < 0 && !root.accel-paused;
                                height: 6px;
                                background: #2a2a2a;
                                border-radius: 3px;
                                clip: true; // keep the sweep inside the rounded track

                                if !track.indeterminate: Rectangle {
                                    x: 0;
                                    width: track.width * Math.max(0.0, Math.min(1.0, root.install-frac));
                                    height: track.height;
                                    background: root.coin-color;
                                    border-radius: 3px;
                                }
                                // Indeterminate sweep. Frame-clock driven like the status
                                // glyphs' motion, and kept in its own conditional element
                                // so the per-frame repaints stop the moment the phase has
                                // a real percentage again.
                                if track.indeterminate: Rectangle {
                                    property <float> t: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                                    width: track.width * 0.35;
                                    // Travels from fully off the left edge to fully off
                                    // the right, so the track briefly empties each cycle.
                                    x: -self.width + (track.width + self.width) * self.t;
                                    height: track.height;
                                    background: root.coin-color;
                                    opacity: 0.8;
                                    border-radius: 3px;
                                }
                            }
                            // Pause/Resume, under the bar, only for an accelerator
                            // transfer. A multi-GB snapshot is far too long to hold
                            // someone hostage to, and it resumes from the same byte —
                            // so stopping costs nothing but the time already spent.
                            // One button toggling between the two states, in place:
                            // whatever stopped the transfer restarts it.
                            // Withdrawn once the daemon is up: the user paused, chose
                            // to start anyway, and the snapshot is moot — resuming
                            // would unpack a chain over the one it's now using.
                            if root.accel-busy || (root.accel-paused && !root.running): HorizontalBox {
                                padding: 0;
                                padding-top: 4px;
                                spacing: 8px;
                                alignment: start;
                                Button {
                                    text: root.accel-paused
                                        ? "Resume"
                                        : (root.accel-pausing ? "Pausing…" : "Pause");
                                    primary: root.accel-paused;
                                    enabled: !root.accel-pausing;
                                    clicked => {
                                        if (root.accel-paused) {
                                            root.accel-continue();
                                        } else {
                                            root.accel-pause();
                                        }
                                    }
                                }
                                Text {
                                    text: root.accel-paused
                                        ? "Resumes from here — or leave it and start the daemon."
                                        : "Safe to pause or quit — this resumes where it stops.";
                                    color: #9a9a9a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Action buttons. Install shows only until the daemon is on
                        // disk; Start enables only when stopped, Stop only when
                        // running; all lock out while an action is in flight.
                        // The wallet button flips Lock/Unlock by the known lock state.
                        if !root.installing: HorizontalBox {
                            padding: 0;
                            spacing: 8px;
                            alignment: start;
                            // Only offered while the coin isn't on disk — a reinstall or
                            // update is a separate, confirmed flow, so this button must
                            // never be a way to redownload over a working install.
                            if !root.installed: Button {
                                text: "Install";
                                enabled: !root.install-busy;
                                clicked => {
                                    root.install-busy = true;
                                    root.install-coin();
                                }
                            }
                            // Replaces Install once the coin is on disk but behind the
                            // bundled core version. Confirmed rather than immediate: it
                            // replaces a working daemon, and the new core may upgrade
                            // chainstate/wallet formats that another app also reads.
                            if root.installed && root.update-available: Button {
                                text: "Update";
                                primary: true;
                                enabled: !root.install-busy && !root.daemon-busy;
                                clicked => {
                                    root.update-open = true;
                                }
                            }
                            Button {
                                text: "Start";
                                // Nothing to start until it's installed — and nothing
                                // to start *again* while one is coming up: a daemon
                                // loading its block index isn't answering RPC yet, and
                                // a second start would just hit the datadir lock.
                                enabled: root.installed && !root.running && !root.daemon-busy && !root.daemon-loading;
                                clicked => {
                                    root.daemon-busy = true;
                                    root.daemon-loading = true; // smiley pulses until it answers
                                    root.start-daemon();
                                }
                            }
                            Button {
                                text: "Stop";
                                enabled: root.running && !root.daemon-busy;
                                clicked => {
                                    root.daemon-busy = true;
                                    root.stop-daemon();
                                }
                            }
                            // A coin whose wallet lives in its daemon: lock/unlock it
                            // over RPC.
                            if root.ew-flags == 0: Button {
                                text: root.wallet-sec == 2 ? "Unlock" : "Lock";
                                // Only meaningful for an encrypted wallet (locked=2,
                                // unlocked=3, unlocked-for-staking=4).
                                enabled: root.wallet-sec == 2 || root.wallet-sec == 3 || root.wallet-sec == 4;
                                clicked => {
                                    if (root.wallet-sec == 2) {
                                        root.unlock-open = true;
                                    } else {
                                        root.lock-wallet();
                                    }
                                }
                            }
                            // A coin with a *managed* wallet (Nerva): one button into
                            // the setup modal, which offers create / restore / unlock
                            // / replace depending on what's actually on disk. Needs a
                            // running daemon — the wallet service talks to it.
                            if root.ew-flags != 0: Button {
                                text: root.wallet-state >= 2 ? "Wallet unlocked" : (root.wallet-state == 1 ? "Unlock wallet" : "Set up wallet");
                                enabled: root.running && root.wallet-state < 2 && root.wallet-stage == 0;
                                clicked => {
                                    root.wallet-op = root.wallet-state == 0 ? 0 : 3;
                                    root.wallet-stage = 1;
                                }
                            }
                        }
                    }

                    // Transactions — newest first, bounded to what the core sends.
                    // Claims the pane's leftover height (see the spacer at the end of
                    // this layout) so the list runs to the bottom of the window
                    // rather than stopping after a few rows.
                    if root.tab == 1 && root.has-transactions: VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;
                        Text {
                            text: "Transactions";
                            color: #e6e6e6;
                            font-size: 17px;
                            font-weight: 600;
                        }
                        // An empty list has three quite different causes, and saying
                        // "No transactions yet" to someone whose daemon simply isn't
                        // running reads as "your history is gone".
                        if root.tx-rows.length == 0: Text {
                            text: !root.running
                                ? "Start the daemon to see your transactions."
                                : (root.ew-flags != 0 && root.wallet-state < 2
                                    ? "Unlock your wallet to see its transactions."
                                    : "No transactions yet.");
                            color: #8a8a8a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.tx-rows.length > 0: ListView {
                            vertical-stretch: 1;
                            for row in root.tx-rows: Rectangle {
                                height: 34px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    // Keep the confirmations column clear of the
                                    // scrollbar, which the list overlays on its own
                                    // content once there's more than a pane-full.
                                    padding-right: 14px;
                                    Text {
                                        text: row.direction;
                                        color: row.incoming ? #7ec27e : #d59b6a;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        width: 80px;
                                    }
                                    Text {
                                        text: row.amount;
                                        color: #e6e6e6;
                                        font-family: "monospace";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: row.when;
                                        color: #8a8a8a;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.confirmations;
                                        color: #6a6a6a;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        width: 90px;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }

                    // Receive — the wallet's own address. Fetched once and cached;
                    // "New address" is the only thing that mints another.
                    if root.tab == 2 && root.has-receive: VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;
                        alignment: start;
                        Text {
                            text: "Receive";
                            color: #e6e6e6;
                            font-size: 17px;
                            font-weight: 600;
                        }
                        if root.receive-address == "": Text {
                            text: !root.running
                                ? "Start the daemon to see your address."
                                : (root.ew-flags != 0 && root.wallet-state < 2
                                    ? "Unlock your wallet to see its address."
                                    : "Fetching your address\u{2026}");
                            color: #8a8a8a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.receive-address != "": Rectangle {
                            height: 72px;
                            background: #181818;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                alignment: center;
                                Text {
                                    text: root.receive-address;
                                    color: #e6e6e6;
                                    font-family: "monospace";
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.receive-address != "": HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: "New address";
                                clicked => { root.new-address(); }
                            }
                        }
                    }

                    // Send. The confirm step below shows the full, untruncated
                    // address — the one typo safety net a machine can't provide.
                    if root.tab == 3 && root.has-send: VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 0;
                        alignment: start;
                        Text {
                            text: "Send";
                            color: #e6e6e6;
                            font-size: 17px;
                            font-weight: 600;
                        }
                        // Reading a wallet and spending from one are different
                        // permissions — an in-daemon wallet lists its history while
                        // locked but won't sign — so this gate is `can-send`, not the
                        // one the other tabs use.
                        if !root.can-send: Text {
                            text: !root.running
                                ? "Start the daemon before sending."
                                : "Unlock your wallet before sending.";
                            color: #8a8a8a;
                            font-size: 13px;
                        }
                        if root.can-send: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Available: " + root.balance-avail;
                                color: #9a9a9a;
                                font-size: 13px;
                            }
                            send-addr := LineEdit { placeholder-text: "Destination address"; }
                            send-amt := LineEdit { placeholder-text: "Amount"; }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button {
                                    text: "Review\u{2026}";
                                    enabled: !root.send-busy;
                                    clicked => {
                                        if (send-addr.text != "" && send-amt.text != "") {
                                            root.send-confirm-address = send-addr.text;
                                            root.send-confirm-amount = send-amt.text;
                                            root.send-result = "";
                                            root.send-confirm-open = true;
                                        }
                                    }
                                }
                            }
                            if root.send-result != "": Text {
                                text: root.send-result;
                                color: root.send-result-error ? #e05c5c : #7ec27e;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Settings (scaffold).
                    if root.tab == 4: VerticalBox {
                        padding: 0;
                        spacing: 10px;
                        vertical-stretch: 0;
                        alignment: start;
                        Placeholder {
                            heading: "Settings";
                            note: "Per-coin options (pruning, connectivity, \u{2026}) will live here.";
                        }
                    }

                    // Mining (only for coins that support it). Status comes off the
                    // daemon's own RPC; starting needs the wallet open, because the
                    // daemon has to be told which address to pay.
                    if root.tab == 5: VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;
                        alignment: start;
                        Text {
                            text: "Mining";
                            color: #e6e6e6;
                            font-size: 17px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.mining
                                ? "Mining \u{2014} " + root.mining-threads + (root.mining-threads == 1 ? " thread at " : " threads at ") + root.mining-hashrate
                                : "Not mining";
                            color: root.mining ? #7ec27e : #8a8a8a;
                            font-size: 14px;
                            font-weight: root.mining ? 600 : 400;
                            wrap: word-wrap;
                        }

                        // Why you can't start yet, in the order the TUI checks.
                        if !root.running: Text {
                            text: "Mining runs inside the daemon \u{2014} start it first.";
                            color: #8a8a8a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.running && !root.mining && root.wallet-state < 2: Text {
                            text: "Unlock your wallet first \u{2014} mining pays block rewards to its receive address.";
                            color: #8a8a8a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.running && !root.mining && root.wallet-state >= 2 && root.receive-address == "": Text {
                            text: "Fetching your payout address\u{2026}";
                            color: #8a8a8a;
                            font-size: 13px;
                        }

                        if root.running && !root.mining && root.wallet-state >= 2 && root.receive-address != "": VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "This machine has " + root.cpu-threads + " CPU threads. Mining uses real CPU and power; leave some free for other work.";
                                color: #7a7a7a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 10px;
                                Text {
                                    text: "Threads";
                                    color: #9a9a9a;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                threads-box := SpinBox {
                                    minimum: 1;
                                    maximum: root.cpu-threads;
                                    value: Math.max(1, Math.floor(root.cpu-threads / 2));
                                    width: 110px;
                                }
                                Button {
                                    text: "Start mining";
                                    enabled: !root.mining-busy;
                                    clicked => { root.mining-start(threads-box.value); }
                                }
                            }
                            Text {
                                text: "Rewards go to " + root.receive-address;
                                color: #6a6a6a;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        if root.mining: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Stop mining";
                                enabled: !root.mining-busy;
                                clicked => { root.mining-stop-open = true; }
                            }
                        }
                        if root.mining-error != "": Text {
                            text: root.mining-error;
                            color: #e05c5c;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    // DigiDollar (only for coins with a chain-native stablecoin).
                    if root.tab == 6: Placeholder {
                        heading: "DigiDollar";
                        note: "Mint, send and redeem the chain-native stablecoin.";
                    }

                    // Soaks up the leftover height so every tab except Transactions
                    // stays top-packed, exactly as it did when the pane carried
                    // `alignment: start`. Transactions opts out, and its list grows
                    // into the space instead.
                    if root.tab != 1: Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }


        // ---- send confirm ----
        // The address is shown in FULL and never truncated: a wrong address is
        // unrecoverable, and this is the last moment anyone can catch one.
        if root.send-confirm-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 400px;
                // Hug the content: with no height a panel fills the whole overlay.
                height: send-body.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.coin-color;

                send-body := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Send " + root.send-confirm-amount + " " + root.coin-name + "?";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "To this address — check every character:";
                        color: #9a9a9a;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 64px;
                        background: #181818;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            alignment: center;
                            Text {
                                text: root.send-confirm-address;
                                color: #e6e6e6;
                                font-family: "monospace";
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Text {
                        text: "A sent transaction cannot be reversed.";
                        color: #e05c5c;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "Cancel";
                            clicked => { root.send-confirm-open = false; }
                        }
                        Button {
                            text: "Send";
                            clicked => {
                                root.send-confirm-open = false;
                                root.send-funds(root.send-confirm-address, root.send-confirm-amount);
                            }
                        }
                    }
                }
            }
        }

        // ---- stop-mining confirm ----
        if root.mining-stop-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 320px;
                height: stop-body.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.coin-color;

                stop-body := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Stop mining?";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "Keep mining";
                            clicked => { root.mining-stop-open = false; }
                        }
                        Button {
                            text: "Stop";
                            clicked => {
                                root.mining-stop-open = false;
                                root.mining-stop();
                            }
                        }
                    }
                }
            }
        }

        // ---- managed-wallet setup modal (external-wallet coins) ----
        // Mirrors the TUI's wallet modal, stage for stage. The rule that is not
        // cosmetic and must not be "simplified" away: a NEW password (create /
        // restore-from-seed) is typed twice and must match, because a mistyped
        // password on a fresh wallet means the funds are unrecoverable. Merely
        // *opening* an existing wallet just fails and is retried, so it asks once.
        //
        // Every field holding a secret lives inside its own stage block, so leaving
        // that stage destroys the field along with what was typed into it. Nothing
        // carries a password or seed between stages — which is why restore-from-seed
        // asks for the words and the password on one screen rather than two.
        if root.wallet-stage != 0: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 400px;
                // Hug the content, so each stage is only as tall as it needs to be —
                // the menu is three buttons, not a full-height slab.
                height: wallet-body.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.coin-color;

                wallet-body := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: root.coin-name + " wallet";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    // --- 1: what would you like to do? ---
                    // The action buttons are gated on the coin's BW_EW_* capability
                    // bits, tested with integer maths since Slint has no bitwise
                    // operators. `wallet-launch-with-pw` is BW_EW_LAUNCH_WITH_PW,
                    // decoded in C++ — see below for why it hides all of them.
                    if root.wallet-stage == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.wallet-launch-with-pw
                                ? "This coin's wallet isn't supported in the desktop app yet."
                                : (root.wallet-state == 0
                                    ? "There's no wallet for this coin yet."
                                    : "This wallet is locked.");
                            color: #9a9a9a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        // A wallet that is launched per-open, with the password on its
                        // command line (Zano, Epic), needs a lifecycle the core hasn't
                        // wired for this front-end yet — every op would return
                        // "Unsupported". Say so, rather than offering buttons that can
                        // only fail and leave the user wondering if they mistyped.
                        if root.wallet-launch-with-pw: Text {
                            text: "Use the terminal app (boxwallet-tui) for this coin's wallet for now. Everything else here — status, sync, mining — works as usual.";
                            color: #8a8a8a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if !root.wallet-launch-with-pw && root.wallet-state != 0: Button {
                            text: "Unlock this wallet";
                            clicked => { root.wallet-op = 3; root.wallet-stage = 2; }
                        }
                        if !root.wallet-launch-with-pw && root.wallet-state == 0: Button {
                            text: "Create a new wallet";
                            clicked => { root.wallet-op = 0; root.wallet-stage = 3; }
                        }
                        // BW_EW_SEED_RESTORE.
                        if !root.wallet-launch-with-pw && root.wallet-state == 0 && Math.mod(Math.floor(root.ew-flags / 2), 2) == 1: Button {
                            text: "Restore from seed words";
                            clicked => { root.wallet-op = 1; root.wallet-stage = 4; }
                        }
                        // BW_EW_FILE_RESTORE.
                        if !root.wallet-launch-with-pw && root.wallet-state == 0 && Math.mod(Math.floor(root.ew-flags / 4), 2) == 1: Button {
                            text: "Restore from a wallet file";
                            clicked => { root.wallet-op = 2; root.wallet-stage = 5; root.browse-open = true; }
                        }
                        // BW_EW_REPLACE — destructive, so it's behind a typed confirm.
                        if !root.wallet-launch-with-pw && root.wallet-state != 0 && Math.mod(Math.floor(root.ew-flags / 8), 2) == 1: Button {
                            text: "Replace this wallet\u{2026}";
                            clicked => { root.wallet-replace-bad = false; root.wallet-stage = 9; }
                        }
                    }

                    // --- 2: an EXISTING wallet's password (open / import) ---
                    if root.wallet-stage == 2: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Password for this wallet";
                            color: #9a9a9a;
                            font-size: 13px;
                        }
                        open-pw := LineEdit {
                            placeholder-text: "Password";
                            input-type: password;
                            accepted => {
                                root.wallet-setup(root.wallet-op, self.text, "", root.picked-file);
                                self.text = "";
                                root.wallet-stage = 6;
                            }
                        }
                        Button {
                            text: root.wallet-op == 2 ? "Import" : "Unlock";
                            clicked => {
                                root.wallet-setup(root.wallet-op, open-pw.text, "", root.picked-file);
                                open-pw.text = "";
                                root.wallet-stage = 6;
                            }
                        }
                    }

                    // --- 3: a NEW wallet's password, twice ---
                    if root.wallet-stage == 3: create-box := VerticalLayout {
                        spacing: 8px;
                        property <bool> mismatch: false;
                        Text {
                            text: "Choose a password for the new wallet";
                            color: #9a9a9a;
                            font-size: 13px;
                        }
                        new-pw := LineEdit {
                            placeholder-text: "Password";
                            input-type: password;
                        }
                        new-pw2 := LineEdit {
                            placeholder-text: "Confirm password";
                            input-type: password;
                            accepted => { create-go.clicked(); }
                        }
                        if create-box.mismatch: Text {
                            text: "Those didn't match. Type both again.";
                            color: #e05c5c;
                            font-size: 12px;
                        }
                        Text {
                            text: "There is no way to recover this password, and no way to recover the wallet without it.";
                            color: #7a7a7a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        create-go := Button {
                            text: "Create wallet";
                            clicked => {
                                if (new-pw.text != "" && new-pw.text == new-pw2.text) {
                                    create-box.mismatch = false;
                                    root.wallet-setup(0, new-pw.text, "", "");
                                    new-pw.text = "";
                                    new-pw2.text = "";
                                    root.wallet-stage = 6;
                                } else {
                                    // Clear both rather than let a half-remembered
                                    // password through on a second guess.
                                    new-pw.text = "";
                                    new-pw2.text = "";
                                    create-box.mismatch = true;
                                }
                            }
                        }
                    }

                    // --- 4: restore from seed words (words + new password together) ---
                    if root.wallet-stage == 4: restore-box := VerticalLayout {
                        spacing: 8px;
                        property <bool> mismatch: false;
                        Text {
                            text: "Enter your " + root.seed-word-count + " seed words, then choose a password for the restored wallet.";
                            color: #9a9a9a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        seed-in := LineEdit {
                            placeholder-text: "seed words, separated by spaces";
                        }
                        res-pw := LineEdit {
                            placeholder-text: "Password";
                            input-type: password;
                        }
                        res-pw2 := LineEdit {
                            placeholder-text: "Confirm password";
                            input-type: password;
                            accepted => { restore-go.clicked(); }
                        }
                        if restore-box.mismatch: Text {
                            text: "Those passwords didn't match. Type both again.";
                            color: #e05c5c;
                            font-size: 12px;
                        }
                        restore-go := Button {
                            text: "Restore wallet";
                            clicked => {
                                if (seed-in.text != "" && res-pw.text != "" && res-pw.text == res-pw2.text) {
                                    restore-box.mismatch = false;
                                    root.wallet-setup(1, res-pw.text, seed-in.text, "");
                                    seed-in.text = "";
                                    res-pw.text = "";
                                    res-pw2.text = "";
                                    root.wallet-stage = 6;
                                } else {
                                    res-pw.text = "";
                                    res-pw2.text = "";
                                    restore-box.mismatch = true;
                                }
                            }
                        }
                    }

                    // --- 5: pick a wallet file (the browse overlay does the work) ---
                    if root.wallet-stage == 5: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.picked-file == ""
                                ? "Choose the wallet file to import."
                                : "Selected: " + root.picked-file;
                            color: #9a9a9a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Button {
                            text: root.picked-file == "" ? "Browse\u{2026}" : "Continue";
                            clicked => {
                                if (root.picked-file == "") {
                                    root.browse-open = true;
                                } else {
                                    root.wallet-stage = 2;
                                }
                            }
                        }
                    }

                    // --- 6: working ---
                    if root.wallet-stage == 6: Text {
                        text: root.wallet-op == 0 ? "Creating the wallet\u{2026}"
                            : root.wallet-op == 1 ? "Restoring from your seed words\u{2026}"
                            : root.wallet-op == 2 ? "Importing the wallet file\u{2026}"
                            : "Opening the wallet\u{2026}";
                        color: #9a9a9a;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    // --- 7: write the seed down ---
                    if root.wallet-stage == 7: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Write these words down, in order, and keep them somewhere safe.";
                            color: #e6e6e6;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 170px;
                            background: #181818;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                alignment: start;
                                Text {
                                    text: root.wallet-seed-words;
                                    color: #e6e6e6;
                                    font-family: "monospace";
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Text {
                            text: "Anyone with these words can spend your funds. They are shown once.";
                            color: #e05c5c;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.wallet-verify-bad: Text {
                            text: "That wasn't the right word — check your copy before trying again.";
                            color: #e05c5c;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "I've written them down";
                            clicked => {
                                root.wallet-verify-bad = false;
                                root.wallet-stage = 8;
                            }
                        }
                    }

                    // --- 8: prove it ---
                    if root.wallet-stage == 8: verify-box := VerticalLayout {
                        spacing: 8px;
                        property <int> pos: root.wallet-verify-step == 0 ? root.verify-pos-1
                            : root.wallet-verify-step == 1 ? root.verify-pos-2
                            : root.verify-pos-3;
                        Text {
                            text: "Backup check " + (root.wallet-verify-step + 1) + " of 3 \u{2014} what is word " + verify-box.pos + "?";
                            color: #9a9a9a;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        verify-in := LineEdit {
                            placeholder-text: "that word";
                            accepted => {
                                if (root.verify-word(verify-box.pos, self.text)) {
                                    self.text = "";
                                    if (root.wallet-verify-step == 2) {
                                        // Verified: the words go now, not later.
                                        root.wallet-seed-words = "";
                                        root.wallet-verify-step = 0;
                                        root.wallet-result = "Backup verified \u{2014} your wallet is ready.";
                                        root.wallet-result-error = false;
                                        root.wallet-stage = 10;
                                    } else {
                                        root.wallet-verify-step += 1;
                                    }
                                } else {
                                    self.text = "";
                                    root.wallet-verify-step = 0;
                                    root.wallet-verify-bad = true;
                                    root.wallet-stage = 7; // back to the words
                                }
                            }
                        }
                    }

                    // --- 9: replace (destructive) ---
                    if root.wallet-stage == 9: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "This deletes this wallet so a different one can take its place. Without a backup of its seed words, its funds are gone for good. Type REPLACE to confirm.";
                            color: #e05c5c;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        replace-in := LineEdit {
                            placeholder-text: "REPLACE";
                            accepted => {
                                if (self.text == "REPLACE") {
                                    self.text = "";
                                    root.wallet-replace-bad = false;
                                    root.wallet-replace();
                                    root.wallet-stage = 6;
                                } else {
                                    root.wallet-replace-bad = true;
                                }
                            }
                        }
                        if root.wallet-replace-bad: Text {
                            text: "Type REPLACE exactly to confirm.";
                            color: #e05c5c;
                            font-size: 12px;
                        }
                    }

                    // --- 10: outcome ---
                    if root.wallet-stage == 10: Text {
                        text: root.wallet-result;
                        color: root.wallet-result-error ? #e05c5c : #7ec27e;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    // Footer. Stages 6-8 have no way out: 6 is already in flight and
                    // abandoning it wouldn't stop it, and 7-8 are the one chance to
                    // record the seed.
                    if root.wallet-stage < 6 || root.wallet-stage == 9 || root.wallet-stage == 10: HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: root.wallet-stage == 10 ? "Close" : "Cancel";
                            clicked => {
                                // Any seed still pending in the core was never shown;
                                // drop it rather than leave it parked.
                                root.seed-discard();
                                root.wallet-seed-words = "";
                                root.wallet-verify-step = 0;
                                root.wallet-verify-bad = false;
                                root.wallet-replace-bad = false;
                                root.wallet-stage = 0;
                            }
                        }
                    }
                }
            }
        }

        // ---- wallet unlock passphrase modal ----
        // The passphrase is a secret: it lives only in the field while typing and is
        // cleared the instant it's handed to the callback (which passes it as bytes
        // to the core, uses it, and wipes that copy).
        if root.unlock-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 320px;
                height: 176px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: #3a3a3a;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Unlock " + root.coin-name + " wallet";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    pw := LineEdit {
                        placeholder-text: "Passphrase";
                        input-type: password;
                        accepted => {
                            root.unlock-wallet(self.text);
                            self.text = "";
                            root.unlock-open = false;
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "Cancel";
                            clicked => {
                                pw.text = "";
                                root.unlock-open = false;
                            }
                        }
                        Button {
                            text: "Unlock";
                            clicked => {
                                root.unlock-wallet(pw.text);
                                pw.text = "";
                                root.unlock-open = false;
                            }
                        }
                    }
                }
            }
        }

        // Update confirm. The TUI asks the same question before its stop → reinstall
        // → restart sequence, and for the same reason: this replaces a daemon that may
        // be running and whose data another application also uses.
        if root.update-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 400px;
                height: 232px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: #3a3a3a;

                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Update " + root.coin-name + "?";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.installed-version + "  →  " + root.coin-version;
                        color: #c8c8c8;
                        font-size: 14px;
                    }
                    Text {
                        // The one risk that can't be engineered away, so it's stated
                        // rather than hidden: a newer core can upgrade chainstate or
                        // wallet formats, and if another app drives this same data
                        // directory it may not be able to open it afterwards.
                        text: "The daemon will be stopped, updated, and restarted if it "
                            + "was running. If another application uses this coin's data "
                            + "directory, a newer core may upgrade it so the older app can "
                            + "no longer open it.";
                        color: #9a9a9a;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    HorizontalBox {
                        padding: 0;
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "Cancel";
                            clicked => {
                                root.update-open = false;
                            }
                        }
                        Button {
                            text: "Update";
                            primary: true;
                            clicked => {
                                root.update-open = false;
                                root.install-busy = true;
                                root.update-coin();
                            }
                        }
                    }
                }
            }
        }

        // Sync-accelerator offer, raised in place of starting the daemon the first
        // time a coin that publishes one is started on an empty chain. Declining is
        // a normal outcome (a full P2P sync still works), so both buttons start the
        // daemon — they differ only in whether the accelerator is fetched first.
        if root.accel-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            Rectangle {
                width: 400px;
                // Fixed heights, since the content is fixed too: the pitch, the
                // caution (four wrapped lines at this width), the optional resume
                // line, and the buttons.
                height: root.accel-resume == "" ? 300px : 332px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: #3a3a3a;

                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: root.accel-name + "?";
                        color: #e6e6e6;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.accel-detail;
                        color: #c8c8c8;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    // What the speed costs. Set apart with an amber rule rather than
                    // dropped in as another grey caption: it's the one thing here the
                    // user is meant to weigh, and grey small print is where warnings
                    // go to be skipped.
                    if root.accel-trust != "": HorizontalBox {
                        padding: 0;
                        spacing: 8px;
                        Rectangle {
                            width: 3px;
                            background: #e0a03a;
                            border-radius: 1.5px;
                        }
                        Text {
                            text: root.accel-trust;
                            color: #e0a03a;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    // Only shown when an earlier attempt left bytes on disk, so
                    // "Resume" doesn't read as committing to the whole download again.
                    if root.accel-resume != "": Text {
                        text: root.accel-resume;
                        color: #9a9a9a;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Text {
                        // The "only makes the first sync faster" tail used to live
                        // here; the caution above now carries that point, better.
                        text: "Without it, " + root.coin-name + " syncs from the network as usual.";
                        color: #9a9a9a;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    // Syncing normally is the highlighted, right-hand default: it's
                    // the choice that needs no trust, so it shouldn't be the one that
                    // takes more effort. The accelerator stays one click away.
                    HorizontalBox {
                        padding: 0;
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: root.accel-resume == "" ? "Download" : "Resume";
                            clicked => {
                                root.accel-open = false;
                                root.accel-accept();
                            }
                        }
                        Button {
                            text: "Sync normally";
                            primary: true;
                            clicked => {
                                root.accel-open = false;
                                root.accel-decline();
                            }
                        }
                    }
                }
            }
        }
        // ---- file-browser overlay ----
        // Declared LAST so it paints above every other overlay: it is opened from
        // *inside* the wallet modal (stage 5, "pick a wallet file"), and a sibling
        // declared earlier would render underneath the dialog that opened it.
        if root.browse-open: Rectangle {
            background: #000000bb;
            TouchArea { }

            panel := Rectangle {
                width: 82%;
                height: 82%;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202020;
                border-radius: 10px;
                border-width: 1px;
                border-color: #3a3a3a;

                VerticalBox {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalBox {
                        spacing: 8px;
                        Text {
                            text: root.browse-path;
                            color: #cfcfcf;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Up";
                            clicked => {
                                root.browse-up();
                            }
                        }
                        Button {
                            text: "Close";
                            clicked => {
                                root.browse-open = false;
                            }
                        }
                    }

                    ListView {
                        for entry[idx] in root.browse-entries: Rectangle {
                            height: 30px;
                            background: ta.has-hover ? #2e2e2e : transparent;
                            HorizontalBox {
                                padding: 2px;
                                padding-left: 8px;
                                alignment: start;
                                Text {
                                    text: entry.is-dir ? entry.name + "/" : entry.name;
                                    color: entry.is-dir ? #e0c56a : #cccccc;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                            ta := TouchArea {
                                clicked => {
                                    root.browse-enter(idx);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

}
