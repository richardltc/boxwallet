// BoxWallet GUI — proof-of-concept window.
//
// Left nav (Home + every coin, alphabetical) switching the right-hand detail,
// which itself has a tab strip (Home / Transactions / Receive / Send / Settings,
// plus Mining / DigiDollar where the coin supports them) — mirroring the TUI.
// Live values are `in` properties pushed from gui/main.cpp over the C ABI (bw_*
// in include/boxwallet.h). Only the Home status tab is wired to live data so
// far; the other tabs are UI scaffolding to explore the look and feel.

import {
    VerticalBox, HorizontalBox, GroupBox, Button, ListView, ScrollView, LineEdit, CheckBox
} from "std-widgets.slint";

// One coin in the left nav (built + sorted by C++).
struct NavCoin {
    name: string,
    color: color,
    index: int, // registry index for bw_* calls (also indexes the embedded logos)
}

// One entry in the in-app file browser's directory listing.
struct BrowseEntry {
    name: string,
    is-dir: bool,
}

// One row in the left nav.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <brush> accent;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    background: selected ? #2b2b2b : (ta.has-hover ? #202020 : transparent);

    Rectangle {
        x: 0;
        width: 4px;
        background: root.selected ? root.accent : transparent;
    }
    HorizontalBox {
        alignment: start;
        padding-left: 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            // Unselected: the same muted grey as inactive tab headers, normal
            // size. Selected: brand colour, bold, and a bit bigger so it stands out.
            font-size: root.selected ? 16px : 14px;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? root.accent : #9a9a9a;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One tab in the detail strip: a monochrome SVG icon (tinted to the accent via
// `colorize`) beside its label, with an accent underline when selected.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <color> accent;
    callback clicked;

    property <color> fg: root.selected ? root.accent : (ta.has-hover ? #d0d0d0 : #9a9a9a);
    height: 50px;
    width: content.preferred-width + 12px;

    content := VerticalBox {
        padding: 0;
        spacing: 4px;
        alignment: center;
        // Wrap the fixed-size icon in a centering row so it sits over the middle
        // of the (wider) label rather than left-aligned in the layout cell.
        HorizontalBox {
            padding: 0;
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.fg;
                width: 22px;
                height: 22px;
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            color: root.fg;
        }
    }
    // Selected underline in the coin's accent.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? root.accent : transparent;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A circular (donut) progress gauge: an arc filled to `frac` of a full turn in
// the coin's brand colour over a grey track, a percentage in the middle, and a
// caption underneath. Drawn with a conic-gradient ring + a hole punched in the
// centre (a disc in the pane colour).
component CircleGauge inherits VerticalBox {
    in property <float> frac;
    in property <brush> fill;
    in property <string> label;
    in property <string> value; // e.g. "4,136,946" or "12.3 GB free"
    in property <string> full-text; // shown in place of "100%" when full (e.g. "Synced")

    property <float> f: Math.max(0.0, Math.min(1.0, root.frac));
    // Smoothly sweep the ring (and count the % readout) whenever the underlying
    // fraction jumps — e.g. a poll advancing the sync, or clearing to 0 on stop.
    animate f { duration: 600ms; easing: ease-in-out; }
    property <length> dia: 72px;

    padding: 0;
    spacing: 6px;
    alignment: start;
    // Wider than the ring so the longest value (e.g. "20.3 GB free") isn't
    // clipped; the label, ring and value are all centred within this width.
    min-width: 112px;

    // Caption above the ring.
    Text {
        text: root.label;
        color: #9a9a9a;
        font-size: 13px;
        horizontal-alignment: center;
    }
    // Ring, centred within the gauge.
    HorizontalBox {
        padding: 0;
        alignment: center;
        Rectangle {
            width: root.dia;
            height: root.dia;
            border-radius: root.dia / 2;
            background: @conic-gradient(root.fill 0turn, root.fill root.f * 1turn, #3a3a3a root.f * 1turn, #3a3a3a 1turn);

            // Centre hole → makes the ring a donut, and holds the readout. The gap
            // (8px vs the outer circle) sets the ring thickness — ~4px.
            Rectangle {
                width: parent.width - 8px;
                height: parent.height - 8px;
                border-radius: (parent.width - 8px) / 2;
                background: #1e1e1e;
                Text {
                    text: (root.f >= 0.999 && root.full-text != "") ? root.full-text : Math.round(root.f * 100) + "%";
                    color: #e6e6e6;
                    font-size: (root.f >= 0.999 && root.full-text != "") ? 13px : 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    // Value below the ring (count / free space), monospaced.
    Text {
        text: root.value;
        color: #c8c8c8;
        font-size: 12px;
        font-family: "DejaVu Sans Mono";
        horizontal-alignment: center;
    }
}

// A status glyph in the row above the Daemon section: a monochrome SVG in the
// coin's brand colour when `active`, greyed out otherwise, with a native hover
// tooltip carrying `hint`. It can also carry a motion to draw attention —
// "hop" (a little jump), "pulse" (fade in/out) or "spin" (rotate) — that runs
// only while `moving` is true. The animated values read `animation-tick()` only
// while moving, so an idle icon costs no repaints.
component StatusIcon inherits Rectangle {
    in property <image> icon;
    in property <color> accent;
    in property <color> idle: #555555;
    in property <bool> active;
    in property <string> hint;
    in property <string> motion: "none"; // "hop" | "pulse" | "spin"
    in property <bool> moving: false;

    width: 45px;
    height: 45px;

    // Shared 0..1 ramp (2s) for hop/pulse; a faster ramp for spin.
    property <float> t: Math.mod(animation-tick() / 1ms, 2000) / 2000;
    property <float> hp: root.t < 0.35 ? root.t / 0.35 : 1.0;
    property <length> hop: -12px * (4 * root.hp * (1.0 - root.hp));
    property <float> pulse-op: 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(root.t * 360deg));
    // Grows the icon in sync with the brightness so a pulse "breathes" outward.
    property <float> pulse-scale: 1.0 + 0.28 * (0.5 + 0.5 * Math.sin(root.t * 360deg));
    property <bool> pulsing: root.moving && root.motion == "pulse";
    property <angle> spin: Math.mod(animation-tick() / 1ms, 900) / 900 * 360deg;

    // One-shot "breath": fire a single pulse each time `pulse-on-increase` rises
    // (e.g. the peer count ticking up). Any upward jump — 0→1 or 1→5 — is exactly
    // one pulse; equal or falling values don't pulse. Frame-clock timed like the
    // title shine, so it stops requesting repaints once the single breath ends.
    in property <int> pulse-on-increase: 0;
    property <int> poi-prev: 0;
    property <duration> shot-start: 0ms;
    property <bool> shot: false;
    function kick-pulse() {
        root.shot-start = animation-tick();
        root.shot = true;
    }
    changed pulse-on-increase => {
        if root.pulse-on-increase > root.poi-prev {
            root.kick-pulse();
        }
        root.poi-prev = root.pulse-on-increase;
    }
    // 0..1 over 600ms while shooting; a single sine bump peaks mid-way then settles.
    property <float> st: root.shot ? (animation-tick() - root.shot-start) / 600ms : 1.0;
    changed st => {
        if root.shot && root.st >= 1.0 {
            root.shot = false;
        }
    }
    property <float> shot-scale: 1.0 + 0.32 * Math.sin(Math.clamp(root.st, 0.0, 1.0) * 180deg);

    Image {
        source: root.icon;
        colorize: root.active ? root.accent : root.idle;
        width: 33px;
        height: 33px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + ((root.moving && root.motion == "hop") ? root.hop : 0px);
        opacity: root.pulsing ? root.pulse-op : 1.0;
        // Scale via a GPU transform around the icon's centre (not by resizing the
        // element), so growing the pulse doesn't pixel-snap/jitter. The same
        // centred origin makes the spin rotate in place rather than orbit.
        transform-scale: root.pulsing ? root.pulse-scale : (root.shot ? root.shot-scale : 1.0);
        transform-rotation: (root.moving && root.motion == "spin") ? root.spin : 0deg;
        transform-origin: { x: 16.5px, y: 16.5px };
    }
    Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// A title wordmark with a one-shot light-sweep shine through the letters. The
// sweep runs on first appearance (`init`) and again whenever the text changes
// (`changed caption`) — so switching straight from one coin to another, which
// only updates the caption of a title element that already exists, still shines.
//
// `animation-tick()` is read only while `sweeping`, so once the ~1.5s sweep ends
// the title stops requesting repaints (no continuous cost when idle).
component ShiningTitle inherits Text {
    in property <string> caption;
    in property <color> base: #7ca071;
    in property <color> shine: #ffffff;

    property <duration> start-tick: 0ms;
    property <bool> sweeping: false;

    function sweep() {
        root.start-tick = animation-tick();
        root.sweeping = true;
    }
    init => {
        root.sweep();
    }
    changed caption => {
        root.sweep();
    }

    // 0..1 over 1.5s while sweeping; pinned at 1 (band off-screen) when idle.
    // Progress is measured on the frame clock (`animation-tick()`), and the sweep
    // ends when progress itself reaches 1 — NOT on a wall-clock timer, which
    // could fire early under frame throttling and cut the sweep off halfway.
    // While sweeping, reading `animation-tick()` keeps frames coming, so it
    // always runs to completion; once done it stops reading it (no idle repaints).
    property <float> t: root.sweeping ? (animation-tick() - root.start-tick) / 1500ms : 1.0;
    changed t => {
        if root.sweeping && root.t >= 1.0 {
            root.sweeping = false;
        }
    }
    property <float> c: root.t * 1.6 - 0.3;

    text: root.caption;
    color: @linear-gradient(100deg,
        root.base 0%,
        root.base clamp(c - 0.18, 0.0, 1.0) * 100%,
        root.shine clamp(c, 0.0, 1.0) * 100%,
        root.base clamp(c + 0.18, 0.0, 1.0) * 100%,
        root.base 100%);
}

// A placeholder tab body — a heading plus a note about what will live here.
component Placeholder inherits VerticalBox {
    in property <string> heading;
    in property <string> note;
    alignment: start;
    spacing: 6px;
    Text {
        text: root.heading;
        color: #d0d0d0;
        font-size: 18px;
        font-weight: 600;
    }
    Text {
        text: root.note;
        color: #9a9a9a;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "BoxWallet";
    icon: @image-url("coin-logos/BoxWallet.png");
    preferred-width: 700px;
    preferred-height: 580px;
    background: #1e1e1e;

    // Navigation. -1 = Home, otherwise the selected coin's registry index.
    in property <[NavCoin]> nav-coins;
    // Per-coin logos, embedded into the binary at build time and indexed by the
    // coin's registry index (NavCoin.index) — the order MUST match the coin order
    // in src/capi.zig's `coinByIndex`. Swap a file in gui/coin-logos/ and rebuild
    // to change a logo.
    property <[image]> coin-logos: [
        @image-url("coin-logos/nexa.png"), // 0
        @image-url("coin-logos/divi.png"), // 1
        @image-url("coin-logos/ergo.png"), // 2
        @image-url("coin-logos/digibyte.png"), // 3
        @image-url("coin-logos/zano.png"), // 4
        @image-url("coin-logos/nerva.png"), // 5
        @image-url("coin-logos/reddcoin.png"), // 6
        @image-url("coin-logos/epic.png"), // 7
        @image-url("coin-logos/salvium.png"), // 8
        @image-url("coin-logos/litecoin.png"), // 9
        @image-url("coin-logos/bitcoin.png"), // 10
        @image-url("coin-logos/bitcoinz.png"), // 11
        @image-url("coin-logos/spiderbyte.png"), // 12
        @image-url("coin-logos/monero.png"), // 13
    ];
    property <int> selected: -1;
    property <int> tab: 0; // 0 Home, 1 Tx, 2 Receive, 3 Send, 4 Settings, 5 Mining, 6 DigiDollar
    callback coin-selected(int);

    // Daemon/wallet action buttons.
    in-out property <bool> daemon-busy: false; // a start/stop is in flight
    property <bool> unlock-open: false;        // passphrase modal visible
    callback start-daemon();
    callback stop-daemon();
    // Sync accelerator (Divi's blockchain snapshot): the user's answer to the
    // prompt raised before the first daemon start. Accept downloads + applies it
    // and then starts; decline starts the daemon without it.
    callback accel-accept();
    callback accel-decline();
    // Ask a running accelerator transfer to stop. What's on disk is kept, so this
    // is a pause, not a cancel — resuming picks up from the same byte.
    callback accel-pause();
    // Pick a paused transfer back up, from the same byte. The counterpart to
    // `accel-pause`: the one button toggles between them.
    callback accel-continue();
    callback install-coin();
    callback update-coin();
    callback lock-wallet();
    callback unlock-wallet(string); // passphrase (secret; cleared right after)

    // Selected-coin metadata (pushed by C++ when the selection changes).
    in property <color> coin-color: #ed295a;
    in property <string> coin-name: "";
    in property <string> coin-desc: "";
    in property <bool> has-mining: false;
    in property <bool> has-stablecoin: false;

    // Live status for the selected coin's Home tab.
    in property <bool> installed: false;
    // Install progress, polled from bw_install_progress: 0 idle, 1 downloading,
    // 2 extracting. `install-frac` is < 0 when the byte total is unknown (no
    // content-length), which the bar renders as indeterminate rather than 0%.
    in property <int> install-phase: 0;
    in property <float> install-frac: 0;
    in property <string> install-bytes: ""; // e.g. "162 MB / 260 MB"
    // True from clicking Install until the worker reports back, so the button
    // can't be double-fired in the window before the first progress poll lands.
    in-out property <bool> install-busy: false;
    property <bool> installing: root.install-busy || root.install-phase != 0;
    // Update state, from bw_update_available / bw_installed_version. An installed
    // coin with no version marker reports not-available and an empty version, so
    // the GUI stays quiet rather than nagging about a version it can't read.
    in property <bool> update-available: false;
    in property <string> installed-version: "";
    property <bool> update-open: false; // update confirm modal visible
    // Sync-accelerator prompt, raised by the C++ side when the coin offers one
    // before its first daemon start (see bw_sync_accel_offered). `accel-resume`
    // is pre-formatted and empty when there's nothing to resume.
    in-out property <bool> accel-open: false;
    // True while the progress bar belongs to a sync-accelerator run rather than an
    // ordinary install — an install has nothing to pause, so the Pause button is
    // gated on this.
    in-out property <bool> accel-busy: false;
    // True once a transfer has been paused and not yet resumed. The progress
    // block stays on screen in that state — frozen bar, byte count, and the
    // Pause button flipped to Resume — so picking it back up is one click on the
    // same button that stopped it, rather than a rediscovered flow. The ordinary
    // action buttons stay live alongside it (see `installing`), so abandoning the
    // transfer and just starting the daemon is still one click too.
    in-out property <bool> accel-paused: false;
    // True between clicking Pause and the transfer actually stopping — it unwinds
    // at a chunk boundary, which on a slow link is a visible moment. Without this
    // the button sits there reading "Pause" as if the click missed.
    in-out property <bool> accel-pausing: false;
    in property <string> accel-name: "";
    in property <string> accel-detail: "";
    in property <string> accel-resume: "";
    in property <bool> running: false;
    in property <bool> synced: false;
    in property <bool> staking: false;
    // True from clicking Start until the daemon answers (the smiley pulses). The
    // remaining placeholders below stay idle until their flows are wired.
    in-out property <bool> daemon-loading: false;
    // What the daemon is doing while it's still coming up, straight from its own
    // warm-up report (bw_daemon_stage): "Loading block index…", "Rewinding…",
    // "Verifying…", "Loading blocks… 42.00%". Empty when it isn't warming up.
    in-out property <string> daemon-stage: "";
    // Wallet lock state (from bw_wallet_security): 0 unknown, 1 unencrypted,
    // 2 locked, 3 unlocked, 4 unlocked-for-staking. 0 (unknown) greys the glyph.
    in property <int> wallet-sec: 0;
    in property <bool> mining: false;
    in property <int> blocks: 0;
    in property <int> headers: 0;
    in property <int> peers: 0;
    in property <string> chain: "";
    in property <float> sync-percent: 0;
    in property <float> headers-frac: 0;
    in property <float> blocks-frac: 0;
    in property <float> disk-frac: 0;
    in property <string> headers-str: ""; // formatted header count
    in property <string> blocks-str: "";  // formatted block count
    in property <string> disk-free: "";    // free space, e.g. "12.3 GB free"
    in property <string> coin-version: ""; // bundled core version
    in property <string> status-text: "";  // latest status line
    in property <bool> status-is-error: false;

    // In-app file browser (the Home "test" button).
    in-out property <bool> browse-open: false;
    in property <string> browse-path: "";
    in property <[BrowseEntry]> browse-entries;
    in property <string> picked-file: "";
    callback browse-home();
    callback browse-up();
    callback browse-enter(int);

    HorizontalBox {
        padding: 0;
        spacing: 0;

        // ---- left nav (Home pinned, coins scroll) ----
        Rectangle {
            width: 160px;
            background: #161616;
            VerticalBox {
                padding: 8px;
                padding-top: 12px;
                spacing: 2px;
                // No `alignment: start` here: the ScrollView must stretch to fill
                // the column (Home stays fixed-height at the top). With an
                // alignment set, the ScrollView would collapse to its preferred
                // height and leave the lower part of the nav empty.
                NavItem {
                    label: "Home";
                    accent: #7ca071;
                    selected: root.selected == -1;
                    clicked => {
                        root.selected = -1;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding: 0;
                        spacing: 2px;
                        alignment: start;
                        for c in root.nav-coins: NavItem {
                            label: c.name;
                            accent: c.color;
                            selected: root.selected == c.index;
                            clicked => {
                                root.selected = c.index;
                                root.tab = 0;
                                root.coin-selected(c.index);
                            }
                        }
                    }
                }
            }
        }

        // ---- detail ----
        Rectangle {
            background: #1e1e1e;

            // HOME
            if root.selected == -1: VerticalBox {
                padding: 26px;
                spacing: 10px;
                alignment: start;
                // App logo + title/version.
                HorizontalBox {
                    padding: 0;
                    spacing: 12px;
                    alignment: start;
                    Image {
                        source: @image-url("coin-logos/BoxWallet.png");
                        image-fit: contain;
                        width: 69px;
                        height: 69px;
                        vertical-alignment: center;
                    }
                    VerticalBox {
                        padding: 0;
                        spacing: 2px;
                        HorizontalBox {
                            padding: 0;
                            alignment: start;
                            ShiningTitle {
                                caption: "BoxWallet";
                                base: #7ca071;
                                font-size: 32px;
                                font-weight: 800;
                            }
                        }
                        Text {
                            text: "v0.8.4";
                            color: #808080;
                            font-size: 14px;
                        }
                    }
                }
                Rectangle {
                    height: 8px;
                }
                Text {
                    text: "Multi-coin cryptocurrency wallet manager.";
                    color: #cfcfcf;
                    font-size: 15px;
                }
                Text {
                    text: "Select a coin on the left to see its status.";
                    color: #9a9a9a;
                    font-size: 14px;
                }
                Rectangle {
                    height: 6px;
                }
                HorizontalBox {
                    padding: 0;
                    alignment: start;
                    Button {
                        text: "Test: browse for a file…";
                        clicked => {
                            root.browse-home();
                            root.browse-open = true;
                        }
                    }
                }
                Text {
                    text: "Selected: " + root.picked-file;
                    color: #7ca071;
                    font-size: 13px;
                    wrap: word-wrap;
                    visible: root.picked-file != "";
                }
            }

            // COIN DETAIL (tabbed)
            if root.selected != -1: VerticalBox {
                padding: 26px;
                spacing: 14px;
                alignment: start;

                // Logo + title/description. The logo is the embedded per-coin
                // image, selected by the coin's registry index (root.selected).
                HorizontalBox {
                    padding: 0;
                    alignment: start;
                    spacing: 12px;
                    Image {
                        source: root.coin-logos[root.selected];
                        image-fit: contain;
                        width: 69px;
                        height: 69px;
                        vertical-alignment: center;
                    }
                    VerticalBox {
                        padding: 0;
                        spacing: 2px;
                        // Title + version, manually placed so the version's bottom
                        // sits on the title's baseline. (A HorizontalBox centres
                        // the two vertically, floating the small version too high.)
                        Rectangle {
                            height: title-el.preferred-height;
                            title-el := ShiningTitle {
                                x: 0;
                                caption: root.coin-name;
                                base: root.coin-color;
                                font-size: 28px;
                                font-weight: 800;
                            }
                            Text {
                                text: root.coin-version;
                                color: #808080;
                                font-size: 13px;
                                x: title-el.preferred-width + 8px;
                                // Bottom-align to the title, nudged up so the
                                // baselines (not the box bottoms) line up.
                                y: parent.height - self.preferred-height - 4px;
                            }
                        }
                        Text {
                            text: root.coin-desc;
                            color: #9a9a9a;
                            font-size: 13px;
                        }
                    }
                }

                // Status glyph row — under the description, so it's visible on
                // every tab (not just the Home/status tab).
                HorizontalBox {
                    padding: 0;
                    spacing: 6px;
                    alignment: start;

                    // Installed — hops while not installed (pointing at the Install
                    // button), and pulses while the install itself runs.
                    StatusIcon {
                        icon: @image-url("icons/download.svg");
                        accent: root.coin-color;
                        active: root.installed || root.installing;
                        hint: root.installing
                            ? (root.install-phase == 2 ? "Installing…" : "Downloading…")
                            : (root.installed
                                ? (root.update-available
                                    ? "Update available: " + root.installed-version + " → " + root.coin-version
                                    : "Installed")
                                : "Not installed — use the Install button");
                        motion: root.installing ? "pulse" : "hop";
                        moving: !root.installed || root.installing;
                    }
                    // Daemon — grey when stopped, pulses while loading, lit when running.
                    StatusIcon {
                        icon: @image-url("icons/smile.svg");
                        accent: root.coin-color;
                        active: root.running || root.daemon-loading;
                        // While it's coming up, name the stage it's actually at
                        // rather than a bare "loading" — a block-index load or a
                        // rewind can run for minutes, and the difference is the
                        // only sign of progress there is.
                        hint: root.daemon-loading
                            ? (root.daemon-stage != "" ? root.daemon-stage : "Daemon loading…")
                            : (root.running ? "Daemon running" : "Daemon not running");
                        motion: "pulse";
                        moving: root.daemon-loading;
                    }
                    // Peers — lit when connected; hint shows the count.
                    StatusIcon {
                        icon: @image-url("icons/wifi.svg");
                        accent: root.coin-color;
                        active: root.running && root.peers > 0;
                        hint: "Peers: " + root.peers;
                        // Pulse once whenever a new peer connection is picked up.
                        pulse-on-increase: root.peers;
                    }
                    // Sync — spins while syncing, static when synced.
                    StatusIcon {
                        icon: @image-url("icons/refresh-cw.svg");
                        accent: root.coin-color;
                        active: root.running;
                        hint: root.running ? (root.synced ? "Synced" : "Syncing…") : "Not running";
                        motion: "spin";
                        moving: root.running && !root.synced;
                    }
                    // Wallet lock — open/closed padlock, lit once the daemon has
                    // answered and we know the wallet's lock state.
                    StatusIcon {
                        icon: (root.wallet-sec == 1 || root.wallet-sec == 3 || root.wallet-sec == 4)
                            ? @image-url("icons/lock-open.svg")
                            : @image-url("icons/lock.svg");
                        accent: root.coin-color;
                        active: root.wallet-sec != 0;
                        hint: root.wallet-sec == 1 ? "Wallet not encrypted"
                            : root.wallet-sec == 2 ? "Wallet locked"
                            : root.wallet-sec == 3 ? "Wallet unlocked"
                            : root.wallet-sec == 4 ? "Unlocked for staking"
                            : "Wallet status unknown";
                    }
                    // Staking (PoS) or Mining (mining coins) — pulses while active.
                    if !root.has-mining: StatusIcon {
                        icon: @image-url("icons/zap.svg");
                        accent: root.coin-color;
                        active: root.staking;
                        hint: root.staking ? "Staking" : "Not staking";
                        motion: "pulse";
                        moving: root.staking;
                    }
                    if root.has-mining: StatusIcon {
                        icon: @image-url("icons/cpu.svg");
                        accent: root.coin-color;
                        active: root.mining;
                        hint: root.mining ? "Mining" : "Not mining";
                        motion: "pulse";
                        moving: root.mining;
                    }
                }

                // Branded divider — full coin colour in the centre, fading to the
                // pane on both ends — between the status icons and the tab strip.
                Rectangle {
                    height: 1px;
                    background: @linear-gradient(90deg, transparent 0%, root.coin-color 25%, transparent 100%);
                }

                // Tab strip.
                HorizontalBox {
                    padding: 0;
                    spacing: 18px;
                    alignment: start;
                    TabButton {
                        label: "Home";
                        icon: @image-url("icons/home.svg");
                        accent: root.coin-color;
                        selected: root.tab == 0;
                        clicked => {
                            root.tab = 0;
                        }
                    }
                    TabButton {
                        label: "Transactions";
                        icon: @image-url("icons/transactions.svg");
                        accent: root.coin-color;
                        selected: root.tab == 1;
                        clicked => {
                            root.tab = 1;
                        }
                    }
                    TabButton {
                        label: "Receive";
                        icon: @image-url("icons/receive.svg");
                        accent: root.coin-color;
                        selected: root.tab == 2;
                        clicked => {
                            root.tab = 2;
                        }
                    }
                    TabButton {
                        label: "Send";
                        icon: @image-url("icons/send.svg");
                        accent: root.coin-color;
                        selected: root.tab == 3;
                        clicked => {
                            root.tab = 3;
                        }
                    }
                    TabButton {
                        label: "Settings";
                        icon: @image-url("icons/settings.svg");
                        accent: root.coin-color;
                        selected: root.tab == 4;
                        clicked => {
                            root.tab = 4;
                        }
                    }
                    if root.has-mining: TabButton {
                        label: "Mining";
                        icon: @image-url("icons/mining.svg");
                        accent: root.coin-color;
                        selected: root.tab == 5;
                        clicked => {
                            root.tab = 5;
                        }
                    }
                    if root.has-stablecoin: TabButton {
                        label: "DigiDollar";
                        icon: @image-url("icons/digidollar.svg");
                        accent: root.coin-color;
                        selected: root.tab == 6;
                        clicked => {
                            root.tab = 6;
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: #333333;
                }

                // ---- tab bodies ----

                // Home / status (live).
                if root.tab == 0: VerticalBox {
                    padding: 0;
                    spacing: 14px;
                    alignment: start;

                    HorizontalBox {
                        padding: 4px;
                        spacing: 40px;
                        alignment: start;
                        CircleGauge {
                            label: "Headers";
                            frac: root.headers-frac;
                            fill: root.coin-color;
                            value: root.headers-str;
                            full-text: "Synced";
                        }
                        CircleGauge {
                            label: "Blocks";
                            frac: root.blocks-frac;
                            fill: root.coin-color;
                            value: root.blocks-str;
                            full-text: "Synced";
                        }
                        CircleGauge {
                            label: "Disk used";
                            frac: root.disk-frac;
                            fill: root.coin-color;
                            value: root.disk-free;
                        }
                    }
                    // Status line — the latest info/action message (like the TUI).
                    HorizontalBox {
                        padding: 0;
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: "Status:";
                            color: #9a9a9a;
                            font-size: 13px;
                        }
                        Text {
                            // A daemon that's still coming up outranks the last
                            // action message: the stage moves on its own (and can
                            // do so for minutes), so it's the live answer to "what
                            // is it doing?". Otherwise the latest action/info
                            // message, falling back to "Staking" while it stakes.
                            text: root.daemon-stage != ""
                                ? root.daemon-stage
                                : (root.status-text != "" ? root.status-text : (root.staking ? "Staking" : ""));
                            // A live stage is progress, never an error — don't
                            // inherit the red from an earlier failed action.
                            color: root.status-is-error && root.daemon-stage == "" ? #e74c3c : #c8c8c8;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    // Install progress — shown in place of the button row while a
                    // download/extract runs, so the rest of the app (and the coin
                    // list) stays usable during a multi-minute install.
                    if root.installing || (root.accel-paused && !root.running): VerticalBox {
                        padding: 0;
                        spacing: 4px;
                        HorizontalBox {
                            padding: 0;
                            spacing: 8px;
                            alignment: start;
                            Text {
                                // "Installing" rather than "Extracting": the unpack is
                                // an implementation detail, and what the user cares
                                // about is that the install is still working.
                                text: root.accel-paused
                                    ? "Paused"
                                    : (root.install-phase == 2 ? "Installing…" : "Downloading…");
                                color: #c8c8c8;
                                font-size: 13px;
                            }
                            Text {
                                // Downloading shows real transferred bytes. Extracting
                                // deliberately shows only a percentage: its byte counts
                                // are positions in the *compressed* archive, so printing
                                // them next to "Extracting…" would read as output size
                                // and understate what lands on disk. The percentage is
                                // the honest part of that measure.
                                text: root.install-phase == 2
                                    ? (root.install-frac < 0 ? "" : "\{Math.round(root.install-frac * 100)}%")
                                    : root.install-bytes;
                                color: #9a9a9a;
                                font-size: 13px;
                            }
                        }
                        // The bar. A known fraction fills proportionally — including
                        // while extracting, which reports its position in the archive.
                        // Where there's genuinely no fraction (a download with no
                        // content-length, or the Windows zip path, which seeks and so
                        // can't report a monotonic position) a segment sweeps the track
                        // instead, so it reads as motion rather than a stalled bar.
                        // `track` is named rather than reached through `parent`: inside a
                        // conditional element `parent` resolves to the enclosing layout,
                        // not to this Rectangle, so the fills must size against `track`.
                        track := Rectangle {
                            // A paused transfer is never indeterminate: a sweeping
                            // segment reads as work in progress, which is the one
                            // thing it isn't. With no fraction it just sits empty.
                            property <bool> indeterminate: root.install-frac < 0 && !root.accel-paused;
                            height: 6px;
                            background: #2a2a2a;
                            border-radius: 3px;
                            clip: true; // keep the sweep inside the rounded track

                            if !track.indeterminate: Rectangle {
                                x: 0;
                                width: track.width * Math.max(0.0, Math.min(1.0, root.install-frac));
                                height: track.height;
                                background: root.coin-color;
                                border-radius: 3px;
                            }
                            // Indeterminate sweep. Frame-clock driven like the status
                            // glyphs' motion, and kept in its own conditional element
                            // so the per-frame repaints stop the moment the phase has
                            // a real percentage again.
                            if track.indeterminate: Rectangle {
                                property <float> t: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                                width: track.width * 0.35;
                                // Travels from fully off the left edge to fully off
                                // the right, so the track briefly empties each cycle.
                                x: -self.width + (track.width + self.width) * self.t;
                                height: track.height;
                                background: root.coin-color;
                                opacity: 0.8;
                                border-radius: 3px;
                            }
                        }
                        // Pause/Resume, under the bar, only for an accelerator
                        // transfer. A multi-GB snapshot is far too long to hold
                        // someone hostage to, and it resumes from the same byte —
                        // so stopping costs nothing but the time already spent.
                        // One button toggling between the two states, in place:
                        // whatever stopped the transfer restarts it.
                        // Withdrawn once the daemon is up: the user paused, chose
                        // to start anyway, and the snapshot is moot — resuming
                        // would unpack a chain over the one it's now using.
                        if root.accel-busy || (root.accel-paused && !root.running): HorizontalBox {
                            padding: 0;
                            padding-top: 4px;
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: root.accel-paused
                                    ? "Resume"
                                    : (root.accel-pausing ? "Pausing…" : "Pause");
                                primary: root.accel-paused;
                                enabled: !root.accel-pausing;
                                clicked => {
                                    if (root.accel-paused) {
                                        root.accel-continue();
                                    } else {
                                        root.accel-pause();
                                    }
                                }
                            }
                            Text {
                                text: root.accel-paused
                                    ? "Resumes from here — or leave it and start the daemon."
                                    : "Safe to pause or quit — this resumes where it stops.";
                                color: #9a9a9a;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Action buttons. Install shows only until the daemon is on
                    // disk; Start enables only when stopped, Stop only when
                    // running; all lock out while an action is in flight.
                    // The wallet button flips Lock/Unlock by the known lock state.
                    if !root.installing: HorizontalBox {
                        padding: 0;
                        spacing: 8px;
                        alignment: start;
                        // Only offered while the coin isn't on disk — a reinstall or
                        // update is a separate, confirmed flow, so this button must
                        // never be a way to redownload over a working install.
                        if !root.installed: Button {
                            text: "Install";
                            enabled: !root.install-busy;
                            clicked => {
                                root.install-busy = true;
                                root.install-coin();
                            }
                        }
                        // Replaces Install once the coin is on disk but behind the
                        // bundled core version. Confirmed rather than immediate: it
                        // replaces a working daemon, and the new core may upgrade
                        // chainstate/wallet formats that another app also reads.
                        if root.installed && root.update-available: Button {
                            text: "Update";
                            primary: true;
                            enabled: !root.install-busy && !root.daemon-busy;
                            clicked => {
                                root.update-open = true;
                            }
                        }
                        Button {
                            text: "Start";
                            // Nothing to start until it's installed — and nothing
                            // to start *again* while one is coming up: a daemon
                            // loading its block index isn't answering RPC yet, and
                            // a second start would just hit the datadir lock.
                            enabled: root.installed && !root.running && !root.daemon-busy && !root.daemon-loading;
                            clicked => {
                                root.daemon-busy = true;
                                root.daemon-loading = true; // smiley pulses until it answers
                                root.start-daemon();
                            }
                        }
                        Button {
                            text: "Stop";
                            enabled: root.running && !root.daemon-busy;
                            clicked => {
                                root.daemon-busy = true;
                                root.stop-daemon();
                            }
                        }
                        Button {
                            text: root.wallet-sec == 2 ? "Unlock" : "Lock";
                            // Only meaningful for an encrypted wallet (locked=2,
                            // unlocked=3, unlocked-for-staking=4).
                            enabled: root.wallet-sec == 2 || root.wallet-sec == 3 || root.wallet-sec == 4;
                            clicked => {
                                if (root.wallet-sec == 2) {
                                    root.unlock-open = true;
                                } else {
                                    root.lock-wallet();
                                }
                            }
                        }
                    }
                }

                // Transactions (scaffold).
                if root.tab == 1: VerticalBox {
                    padding: 0;
                    spacing: 8px;
                    alignment: start;
                    Placeholder {
                        heading: "Transactions";
                        note: "Recent wallet transactions will list here, newest first.";
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in [
                            { d: "—  no wallet loaded yet", a: "" },
                        ]: Rectangle {
                            height: 28px;
                            Text {
                                x: 0;
                                text: row.d;
                                color: #8a8a8a;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Receive (scaffold).
                if root.tab == 2: VerticalBox {
                    padding: 0;
                    spacing: 12px;
                    alignment: start;
                    Placeholder {
                        heading: "Receive";
                        note: "Your deposit address and its QR code will appear here.";
                    }
                    Rectangle {
                        width: 140px;
                        height: 140px;
                        background: #2a2a2a;
                        border-radius: 6px;
                        Text {
                            text: "QR";
                            color: #666;
                            font-size: 20px;
                        }
                    }
                    Text {
                        text: "(address)";
                        color: #8a8a8a;
                        font-size: 13px;
                    }
                }

                // Send (scaffold — real widgets, no action yet).
                if root.tab == 3: VerticalBox {
                    padding: 0;
                    spacing: 10px;
                    alignment: start;
                    Placeholder {
                        heading: "Send";
                        note: "Enter a destination address and amount, then confirm.";
                    }
                    LineEdit {
                        placeholder-text: "Destination address";
                    }
                    LineEdit {
                        placeholder-text: "Amount";
                    }
                    HorizontalBox {
                        padding: 0;
                        alignment: start;
                        Button {
                            text: "Send";
                            enabled: false;
                        }
                    }
                }

                // Settings (scaffold).
                if root.tab == 4: VerticalBox {
                    padding: 0;
                    spacing: 10px;
                    alignment: start;
                    Placeholder {
                        heading: "Settings";
                        note: "Per-coin options (pruning, connectivity, …) will live here.";
                    }
                    CheckBox {
                        text: "Start daemon on launch";
                        checked: false;
                    }
                    CheckBox {
                        text: "Prune the blockchain";
                        checked: false;
                    }
                }

                // Mining (only for coins that support it).
                if root.tab == 5: Placeholder {
                    heading: "Mining";
                    note: "Start/stop the daemon's built-in miner and watch its hashrate.";
                }

                // DigiDollar (only for coins with a chain-native stablecoin).
                if root.tab == 6: Placeholder {
                    heading: "DigiDollar";
                    note: "Mint, send and redeem the chain-native stablecoin.";
                }
            }
        }
    }

    // ---- file-browser overlay (opened by the Home "test" button) ----
    if root.browse-open: Rectangle {
        background: #000000bb;
        TouchArea { }

        panel := Rectangle {
            width: 82%;
            height: 82%;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202020;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3a3a3a;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: root.browse-path;
                        color: #cfcfcf;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Up";
                        clicked => {
                            root.browse-up();
                        }
                    }
                    Button {
                        text: "Close";
                        clicked => {
                            root.browse-open = false;
                        }
                    }
                }

                ListView {
                    for entry[idx] in root.browse-entries: Rectangle {
                        height: 30px;
                        background: ta.has-hover ? #2e2e2e : transparent;
                        HorizontalBox {
                            padding: 2px;
                            padding-left: 8px;
                            alignment: start;
                            Text {
                                text: entry.is-dir ? entry.name + "/" : entry.name;
                                color: entry.is-dir ? #e0c56a : #cccccc;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                        ta := TouchArea {
                            clicked => {
                                root.browse-enter(idx);
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- wallet unlock passphrase modal ----
    // The passphrase is a secret: it lives only in the field while typing and is
    // cleared the instant it's handed to the callback (which passes it as bytes
    // to the core, uses it, and wipes that copy).
    if root.unlock-open: Rectangle {
        background: #000000bb;
        TouchArea { }

        Rectangle {
            width: 320px;
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202020;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3a3a3a;

            VerticalBox {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: "Unlock " + root.coin-name + " wallet";
                    color: #e6e6e6;
                    font-size: 15px;
                    font-weight: 600;
                }
                pw := LineEdit {
                    placeholder-text: "Passphrase";
                    input-type: password;
                    accepted => {
                        root.unlock-wallet(self.text);
                        self.text = "";
                        root.unlock-open = false;
                    }
                }
                HorizontalBox {
                    padding: 0;
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            pw.text = "";
                            root.unlock-open = false;
                        }
                    }
                    Button {
                        text: "Unlock";
                        clicked => {
                            root.unlock-wallet(pw.text);
                            pw.text = "";
                            root.unlock-open = false;
                        }
                    }
                }
            }
        }
    }

    // Update confirm. The TUI asks the same question before its stop → reinstall
    // → restart sequence, and for the same reason: this replaces a daemon that may
    // be running and whose data another application also uses.
    if root.update-open: Rectangle {
        background: #000000bb;
        TouchArea { }

        Rectangle {
            width: 400px;
            height: 232px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202020;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3a3a3a;

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "Update " + root.coin-name + "?";
                    color: #e6e6e6;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.installed-version + "  →  " + root.coin-version;
                    color: #c8c8c8;
                    font-size: 14px;
                }
                Text {
                    // The one risk that can't be engineered away, so it's stated
                    // rather than hidden: a newer core can upgrade chainstate or
                    // wallet formats, and if another app drives this same data
                    // directory it may not be able to open it afterwards.
                    text: "The daemon will be stopped, updated, and restarted if it "
                        + "was running. If another application uses this coin's data "
                        + "directory, a newer core may upgrade it so the older app can "
                        + "no longer open it.";
                    color: #9a9a9a;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                HorizontalBox {
                    padding: 0;
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.update-open = false;
                        }
                    }
                    Button {
                        text: "Update";
                        primary: true;
                        clicked => {
                            root.update-open = false;
                            root.install-busy = true;
                            root.update-coin();
                        }
                    }
                }
            }
        }
    }

    // Sync-accelerator offer, raised in place of starting the daemon the first
    // time a coin that publishes one is started on an empty chain. Declining is
    // a normal outcome (a full P2P sync still works), so both buttons start the
    // daemon — they differ only in whether the accelerator is fetched first.
    if root.accel-open: Rectangle {
        background: #000000bb;
        TouchArea { }

        Rectangle {
            width: 400px;
            height: root.accel-resume == "" ? 226px : 258px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202020;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3a3a3a;

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.accel-name + "?";
                    color: #e6e6e6;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.accel-detail;
                    color: #c8c8c8;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                // Only shown when an earlier attempt left bytes on disk, so
                // "Resume" doesn't read as committing to the whole download again.
                if root.accel-resume != "": Text {
                    text: root.accel-resume;
                    color: #9a9a9a;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Without it, " + root.coin-name + " syncs from the network as "
                        + "usual — this only makes the first sync faster.";
                    color: #9a9a9a;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                HorizontalBox {
                    padding: 0;
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Sync normally";
                        clicked => {
                            root.accel-open = false;
                            root.accel-decline();
                        }
                    }
                    Button {
                        text: root.accel-resume == "" ? "Download" : "Resume";
                        primary: true;
                        clicked => {
                            root.accel-open = false;
                            root.accel-accept();
                        }
                    }
                }
            }
        }
    }
}
